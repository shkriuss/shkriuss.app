// Cloudflare Worker for this app. Static files only: no server code runs.
// Docs: docs/deployment.md
{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "template-app",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "./dist",
    "not_found_handling": "404-page",
    "html_handling": "auto-trailing-slash",
  },
  // The real address. Cloudflare creates the DNS record and certificate.
  "routes": [{ "pattern": "template-app.shkriuss.app", "custom_domain": true }],
  // Only at the real address: no *.workers.dev address, and no addresses for
  // single versions either (docs/adr/0019-no-pull-request-previews.md).
  // No Workers logs or traces: nothing about requests is kept (see the privacy page).
  "observability": { "enabled": false },
  "workers_dev": false,
  "preview_urls": false,
}
