# Gradle and Android build output
.gradle/
build/
.kotlin/
captures/
.externalNativeBuild/
.cxx/
local.properties

# Gradle writes the dependency verification keyring twice. Only the readable
# copy, android/gradle/verification-keyring.keys, is committed.
android/gradle/verification-keyring.gpg

# Signing material never belongs in the repository
*.jks
*.keystore
*.p12
*.pfx

# Secrets and local environment files
.env
.env.*
.dev.vars

# Python bytecode from the site generator's tests in tools/site/
__pycache__/

# Node and Cloudflare tooling for backend/ and .github/site-deploy/
node_modules/
.wrangler/

# Editors and IDEs
.idea/
*.iml
.vscode/
*.swp
*~

# Operating systems
.DS_Store
Thumbs.db
