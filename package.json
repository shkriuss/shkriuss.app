    "test": "turbo run test --concurrency=1",
    "build": "turbo run build",
    "check": "node tooling/checks/src/cli.ts",
    "create-app": "node tooling/create-app/src/cli.ts",
    "e2e": "turbo run e2e --concurrency=1",
    "verify": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm test && pnpm build && pnpm check && pnpm e2e"
  },
  "devDependencies": {
    "oxlint": "catalog:",
    "oxlint-tsgolint": "catalog:",
    "prettier": "catalog:",
