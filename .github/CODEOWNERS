# Owner-only paths. A change to any of these needs the owner's review.
# See docs/development/working-with-claude.md.

/.github/                                    @shkriuss
/CLAUDE.md                                   @shkriuss
/.claude/                                    @shkriuss
/android/gradle/verification-metadata.xml    @shkriuss
/android/gradle/verification-keyring.keys    @shkriuss
/android/gradle/wrapper/                     @shkriuss

# The repositories the build downloads from.
/android/settings.gradle.kts                 @shkriuss
/android/build-logic/settings.gradle.kts     @shkriuss

# Build checks that enforce hard rules 1, 2, 3 and 4 and that Android's
# own backup and device transfer are off, the readers the APK rules check
# uses, and the plugin that connects them to the build.
/android/build-logic/src/main/kotlin/app/shkriuss/buildlogic/CheckApkRulesTask.kt                   @shkriuss
/android/build-logic/src/main/kotlin/app/shkriuss/buildlogic/ApkResourceReader.kt                   @shkriuss
/android/build-logic/src/main/kotlin/app/shkriuss/buildlogic/DexMethodReferences.kt                 @shkriuss
/android/build-logic/src/main/kotlin/app/shkriuss/buildlogic/CheckGraphicsPathUseTask.kt            @shkriuss
/android/build-logic/src/main/kotlin/app/shkriuss/buildlogic/AndroidApplicationConventionPlugin.kt  @shkriuss

# The build check that enforces hard rule 10 (main code never logs). It
# is connected to the build in AndroidCommon.kt, below.
/android/build-logic/src/main/kotlin/app/shkriuss/buildlogic/CheckNoLoggingTask.kt                  @shkriuss

# The tests of the build checks, and the build file of build-logic, which
# sets those tests up (step 1.9).
/android/build-logic/build.gradle.kts                                                               @shkriuss
/android/build-logic/src/test/kotlin/app/shkriuss/buildlogic/NoLoggingCheckTest.kt                  @shkriuss
/android/build-logic/src/test/kotlin/app/shkriuss/buildlogic/CoreTestingGuardTest.kt                @shkriuss
/android/build-logic/src/test/kotlin/app/shkriuss/buildlogic/ApkResourceReaderTest.kt               @shkriuss
/android/build-logic/src/test/kotlin/app/shkriuss/buildlogic/BackupRulesTest.kt                     @shkriuss
/android/build-logic/src/test/kotlin/app/shkriuss/buildlogic/WebViewAndCodeLoadingRulesTest.kt      @shkriuss
/android/build-logic/src/test/kotlin/app/shkriuss/buildlogic/BinaryResourceWriter.kt                @shkriuss
/android/build-logic/src/test/kotlin/app/shkriuss/buildlogic/DexWriter.kt                           @shkriuss

# The R8 rules every app shares. The APK rules check depends on them: they
# keep the names of classes, and they keep classes of Google Play services
# and of the test fixtures of core/crypto as they are, so that the check
# can find one that reaches an app (ADR 0029).
/android/build-logic/r8/app-rules.pro                                                               @shkriuss

# Build checks that enforce the record rules of ADR 0026 and 0027 (schema
# files committed, no DAO that deletes or writes past RecordWriter), and
# the plugin that connects them to the build.
/android/build-logic/src/main/kotlin/app/shkriuss/buildlogic/CheckRoomSchemasTask.kt                @shkriuss
/android/build-logic/src/main/kotlin/app/shkriuss/buildlogic/CheckDaoRulesTask.kt                   @shkriuss
/android/build-logic/src/main/kotlin/app/shkriuss/buildlogic/AndroidRoomConventionPlugin.kt         @shkriuss

# The runner of the tests on an emulator, the plugin that sets it for a
# module, and the build check that fails when a test class is not in the
# suite the runner runs (ADR 0028).
/android/core/testing/src/main/kotlin/app/shkriuss/core/testing/InstrumentedTestRunner.kt                    @shkriuss
/android/build-logic/src/main/kotlin/app/shkriuss/buildlogic/AndroidInstrumentedTestConventionPlugin.kt     @shkriuss
/android/build-logic/src/main/kotlin/app/shkriuss/buildlogic/CheckInstrumentedTestSuiteTask.kt              @shkriuss

# Settings every Android module shares, including the refusal of the
# bundled SQLite driver (hard rule 2, ADR 0004), the logging check and
# the refusal of core/testing outside tests (hard rule 10).
/android/build-logic/src/main/kotlin/app/shkriuss/buildlogic/AndroidCommon.kt                       @shkriuss

# Signing configuration and key material, wherever they appear.
# Release and preview signing are planned to run only in workflows under
# .github/, which is covered above.
# Open: the path of any signing config inside the Gradle project.
# Add it here when it exists.
*.jks                                        @shkriuss
*.keystore                                   @shkriuss
*.p12                                        @shkriuss
*.pfx                                        @shkriuss

# The signing certificate's fingerprint. The release workflow refuses to
# release an APK whose certificate is different, and users check the apps
# against it. Only the owner provides it.
/docs/security/fingerprints.md               @shkriuss
