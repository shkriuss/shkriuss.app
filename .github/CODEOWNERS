# Owner-only paths. A change to any of these needs the owner's review.
# See docs/development/working-with-claude.md.

/.github/                                    @shkriuss
/CLAUDE.md                                   @shkriuss
/.claude/                                    @shkriuss
/android/gradle/verification-metadata.xml    @shkriuss
/android/gradle/verification-keyring.keys    @shkriuss
/android/gradle/wrapper/                     @shkriuss

# The repositories the build downloads from.
/android/settings.gradle.kts                 @shkriuss
/android/build-logic/settings.gradle.kts     @shkriuss

# Build checks that enforce hard rules 2, 3 and 4, and the plugin that
# connects them to the build.
/android/build-logic/src/main/kotlin/app/shkriuss/buildlogic/CheckApkRulesTask.kt                   @shkriuss
/android/build-logic/src/main/kotlin/app/shkriuss/buildlogic/CheckGraphicsPathUseTask.kt            @shkriuss
/android/build-logic/src/main/kotlin/app/shkriuss/buildlogic/AndroidApplicationConventionPlugin.kt  @shkriuss

# Signing configuration and key material, wherever they appear.
# Release and preview signing are planned to run only in workflows under
# .github/, which is covered above.
# Open: the path of any signing config inside the Gradle project.
# Add it here when it exists.
*.jks                                        @shkriuss
*.keystore                                   @shkriuss
*.p12                                        @shkriuss
*.pfx                                        @shkriuss
