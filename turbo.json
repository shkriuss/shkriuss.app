{
  "$schema": "https://turborepo.com/schema.json",
  "ui": "stream",
  "agentGuidance": false,
  "tasks": {
    "transit": {
      "dependsOn": ["^transit"]
    },
    "typecheck": {
      "dependsOn": ["transit"],
      "outputs": []
    },
    "test": {
      "dependsOn": ["transit"],
      "outputs": []
    },
    "build": {
      // Every build writes its commit's date into /.well-known/security.txt (@shkriuss/edge),
      // or SOURCE_DATE_EPOCH's. The cache knows files, not commits, so it would give a new
      // commit an earlier one's file: builds are never cached, and take seconds.
      "dependsOn": ["^build"],
      "cache": false,
      "passThroughEnv": ["SOURCE_DATE_EPOCH"]
    },
    "e2e": {
      "dependsOn": ["build"],
      "cache": false,
      "passThroughEnv": ["CI", "E2E_CHROMIUM_EXECUTABLE", "PLAYWRIGHT_BROWSERS_PATH"]
    }
  }
}
