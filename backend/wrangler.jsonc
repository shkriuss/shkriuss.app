// The sync server's Worker. The build, the tests and the deploy all use
// this file. The deploy job of .github/workflows/backend.yml puts the
// ID of the user's own D1 database in place of the zero ID below.
// Why it is set up this way: docs/adr/0043-backend-tools-tests-and-deploy.md.
{
  // The Worker the user creates by hand. The deploy token may edit only
  // this Worker and cannot create one.
  "name": "shkriuss-sync",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-01",
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "shkriuss-sync",
      "database_id": "00000000-0000-0000-0000-000000000000"
    }
  ],
  "r2_buckets": [
    {
      "binding": "FILES",
      "bucket_name": "shkriuss-sync"
    }
  ],
  // The server logs nothing about a request (sync-protocol.md, "What the
  // server stores", point 4).
  "observability": { "enabled": false },
  "logpush": false,
  // The address <name>.<account subdomain>.workers.dev stays on: it is
  // the server's address until the user attaches a domain. Preview
  // addresses for each version are off.
  "workers_dev": true,
  "preview_urls": false,
  // No routes and no custom domains here, so the deploy never changes
  // them, and the token needs no zone permission.
  "send_metrics": false
}
