<?xml version="1.0" encoding="utf-8"?>
<!--
  The manifest of the test APK of core/crypto. It is installed only on the
  emulator in CI and is never part of an app.
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!--
      Android's own system prompt needs this permission. Here it is for the
      test APK only. The first app that shows the prompt gets its own
      decision record (crypto-design.md, open questions).
    -->
    <uses-permission android:name="android.permission.USE_BIOMETRIC" />

    <application>
        <!-- An empty screen. Android shows the system prompt only to an app that is in front. -->
        <activity
            android:name="app.shkriuss.core.crypto.PromptHostActivity"
            android:exported="false" />
    </application>

</manifest>
