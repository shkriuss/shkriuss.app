<?xml version="1.0" encoding="utf-8"?>
<!--
    Reminders (app.shkriuss.reminders). Its permissions are listed in
    docs/security/permissions.md. It holds the five of Water, which are its
    allow list in the APK rules check, and none of its own:

    - the three of core/notify, for its reminders. core/notify adds them
      and its three receivers, none exported;
    - the two of core/security, for the system prompt (ADR 0031) and for
      hiding other apps' windows (ADR 0033). core/security adds them and
      its six screens, none exported. The APK rules check fails an app
      that has the screens without both permissions.

    Reminders stores its data in its own database and backs it up only
    into the backup file of the suite, so Android backup and
    device-to-device transfer are turned off (docs/user/backup.md).
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!--
        androidx.core adds this permission for Android 12 and older only,
        below the minimum. Removed for good, as in Water.
    -->
    <permission
        android:name="${applicationId}.DYNAMIC_RECEIVER_NOT_EXPORTED_PERMISSION"
        tools:node="remove" />
    <uses-permission
        android:name="${applicationId}.DYNAMIC_RECEIVER_NOT_EXPORTED_PERMISSION"
        tools:node="remove" />

    <application
        android:name=".RemindersApp"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.Shk">

        <!--
            The one screen of Reminders' own, and the only exported part. All
            of its content is in AppLockGate. The six screens of
            core/security come from that module's manifest, and none of them
            is exported.
        -->
        <activity
            android:name=".RemindersActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!--
            androidx.profileinstaller adds this receiver, exported to every
            caller with android.permission.DUMP: the system and the developer
            shell. Removed, as in Water: Reminders lets no other app reach any
            part of it but its screen (docs/apps/reminders/spec.md,
            "Permissions"). The start-up profile is still installed when the
            app starts, by the profile installer's initializer in
            androidx.startup.

            Lint cannot see this class: the library comes in only at run
            time. The removal works, which RemindersManifestTest checks in the
            merged manifest. So MissingClass is ignored here only.
        -->
        <receiver
            android:name="androidx.profileinstaller.ProfileInstallReceiver"
            tools:ignore="MissingClass"
            tools:node="remove" />

        <!--
            Emoji support would look for a downloadable font from a system
            font provider. On most phones that is Google Play services, which
            the suite never uses. Android ships its own emoji font. As in
            Water's manifest.

            Lint cannot see this provider class, because it comes from a
            library that Compose uses only at run time (androidx.startup).
            The class is in the APK, so MissingClass is ignored here only.
        -->
        <provider
            android:name="androidx.startup.InitializationProvider"
            android:authorities="${applicationId}.androidx-startup"
            android:exported="false"
            tools:ignore="MissingClass"
            tools:node="merge">
            <meta-data
                android:name="androidx.emoji2.text.EmojiCompatInitializer"
                tools:node="remove" />
        </provider>
    </application>
</manifest>
