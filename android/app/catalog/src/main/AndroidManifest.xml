<?xml version="1.0" encoding="utf-8"?>
<!--
    The Catalog app declares no permissions, and removes those its libraries
    ask for. See docs/security/permissions.md.
    Catalog stores no data, so Android backup and device-to-device transfer
    are turned off.
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!--
        androidx.core adds this permission for Android 12 and older only.
        The minimum is Android 13, so it is never used. Remove it.
    -->
    <permission
        android:name="${applicationId}.DYNAMIC_RECEIVER_NOT_EXPORTED_PERMISSION"
        tools:node="remove" />
    <uses-permission
        android:name="${applicationId}.DYNAMIC_RECEIVER_NOT_EXPORTED_PERMISSION"
        tools:node="remove" />

    <!--
        core/security asks for this to show the system prompt. Catalog shows
        its screens with sample data only and holds no keys, so it never
        shows the prompt. Remove it (ADR 0031).
    -->
    <uses-permission
        android:name="android.permission.USE_BIOMETRIC"
        tools:node="remove" />

    <application
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.Shk">

        <activity
            android:name=".CatalogActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!--
            The screens of core/security work only with keys. Catalog draws
            their content on its own page instead, so they are removed.
        -->
        <activity
            android:name="app.shkriuss.core.security.SecurityActivity"
            tools:node="remove" />
        <activity
            android:name="app.shkriuss.core.security.CreateRecoveryKeyActivity"
            tools:node="remove" />
        <activity
            android:name="app.shkriuss.core.security.EnterRecoveryKeyActivity"
            tools:node="remove" />
        <activity
            android:name="app.shkriuss.core.security.ShowRecoveryKeyActivity"
            tools:node="remove" />
        <activity
            android:name="app.shkriuss.core.security.AppLockActivity"
            tools:node="remove" />
        <activity
            android:name="app.shkriuss.core.security.TurnOnAppLockActivity"
            tools:node="remove" />

        <!--
            Emoji support would look for a downloadable font from a system
            font provider. On most phones that is Google Play services, which
            the suite never uses. Android 13 and later ship their own emoji
            font.

            Lint cannot see this provider class, because it comes from a
            library that Compose uses only at run time (androidx.startup).
            The class is in the APK, so MissingClass is ignored here only.
        -->
        <provider
            android:name="androidx.startup.InitializationProvider"
            android:authorities="${applicationId}.androidx-startup"
            android:exported="false"
            tools:ignore="MissingClass"
            tools:node="merge">
            <meta-data
                android:name="androidx.emoji2.text.EmojiCompatInitializer"
                tools:node="remove" />
        </provider>
    </application>
</manifest>
