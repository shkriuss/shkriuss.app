    <!-- Buttons page. -->
    <string name="buttons_intro">Touch and hold a button to see it pressed. The buttons on this page do nothing when tapped.</string>
    <string name="buttons_filled_title">Filled button</string>
    <string name="buttons_filled_use">The main action of a screen, such as Save. At most one on a screen.</string>
    <string name="buttons_tonal_title">Tonal button</string>
    <string name="buttons_tonal_use">An action that matters, but less than the main one. Not on sheets or dialogs, which use text buttons.</string>
    <string name="buttons_text_title">Text button</string>
    <string name="buttons_text_use">The quietest button: actions in dialogs, sheets, cards and lists.</string>
    <string name="buttons_icon_title">Icon button</string>
    <string name="buttons_icon_use">A common action whose icon is clear on its own, such as search. TalkBack reads its label.</string>

    <!-- Floating action buttons page. -->
    <string name="fab_intro">In an app it floats in the bottom end corner of the screen; here it sits in the page. It has no disabled state: when its action is not possible, the app leaves it out.</string>
    <string name="fab_title">Floating action button</string>
    <string name="fab_use">The one positive action a screen is for, such as adding a note. TalkBack reads its label.</string>
    <string name="fab_extended_title">Extended floating action button</string>
    <string name="fab_extended_use">The same, with text, when the icon alone is not clear. It can collapse to its icon while a list scrolls.</string>

    <!-- Chips page. -->
    <string name="chips_intro">Chips are small and sit in groups. Only the chips under Try it do something when tapped.</string>
    <string name="chips_filter_title">Filter chip</string>
    <string name="chips_filter_use">Turns a filter on or off, such as Done above a list of tasks. A selected chip is filled and shows a check mark.</string>
    <string name="chips_assist_title">Assist chip</string>
    <string name="chips_assist_use">Starts a small, optional action related to the content near it, such as adding a reminder to a task.</string>

    <!-- Text fields page. -->
    <string name="text_fields_intro">Tap a field to focus it: its border and label turn the accent colour. Only the field under Try it takes typing.</string>
    <string name="text_field_title">Text field</string>
    <string name="text_field_use">Typing text, such as a name or an amount. The label sits above the field and TalkBack reads it with the field.</string>

    <!-- Selection controls page. -->
    <string name="selection_intro">The whole row is the touch target, text included. Only the rows under Try it change when tapped.</string>
    <string name="selection_checkbox_title">Checkbox</string>
    <string name="selection_checkbox_use">An option in a form that is saved later, such as Remind me in a new task. Several can be checked.</string>
    <string name="selection_switch_title">Switch</string>
    <string name="selection_switch_use">A setting that takes effect at once. When on, it is filled and its thumb shows a check mark.</string>
    <string name="selection_radio_title">Radio button</string>
    <string name="selection_radio_use">One choice out of a few, all shown. Exactly one is selected. TalkBack reads its place in the group.</string>

    <!-- Sliders page. -->
    <string name="sliders_intro">TalkBack reads the label and the value in words, not a percentage. Only the slider under Try it moves.</string>
    <string name="slider_title">Slider</string>
    <string name="slider_use">Picking a value in a range, such as a daily goal. With steps, it snaps to whole values.</string>
</resources>
