<?xml version="1.0" encoding="utf-8"?>
<!--
    Every word of Tasks' screens (docs/apps/tasks/spec.md, "Screens").
    Dates and times come already in the phone's format, such as "Wed 18
    Nov" and "18:30", and counts in its number format, such as "1,250", so
    the plurals take them as text and the number as the quantity.
-->
<resources>
    <!-- The three destinations. -->
    <string name="tasks_today">Today</string>
    <string name="tasks_lists">Lists</string>
    <string name="tasks_settings">Settings</string>

    <!-- The fixed list of tasks that are in no list. -->
    <string name="tasks_inbox">Inbox</string>

    <!-- The repeats, as the form offers them and the rows show them. -->
    <string name="tasks_once">Once</string>
    <string name="tasks_every_day">Every day</string>
    <string name="tasks_every_week">Every week</string>
    <string name="tasks_every_month">Every month</string>
    <string name="tasks_every_year">Every year</string>
    <!-- The same as TalkBack reads them in a row: "Pay rent, due today at 10:00, every month, Home". -->
    <string name="tasks_every_day_spoken">every day</string>
    <string name="tasks_every_week_spoken">every week</string>
    <string name="tasks_every_month_spoken">every month</string>
    <string name="tasks_every_year_spoken">every year</string>

    <!--
        One row: the title, and under it its parts, one after the other:
        "Home · 09:00 · Every day" on Today, "Fri 20 Nov · Every week" in a
        list. In a list, a task due today says "Today".
    -->
    <string name="tasks_row_parts">%1$s · %2$s</string>
    <string name="tasks_due_today">Today</string>
    <!-- A done task in section Done: "Done Mon 16 Nov". -->
    <string name="tasks_done_on">Done %1$s</string>
    <!--
        One row as TalkBack reads it, one part after the other: "Pay rent,
        due today at 10:00, every month, Home", then whether it is done:
        "not done", or "done on Monday 16 November".
    -->
    <string name="tasks_spoken_parts">%1$s, %2$s</string>
    <string name="tasks_due_today_spoken">due today</string>
    <string name="tasks_due_today_at_spoken">due today at %1$s</string>
    <string name="tasks_due_on_spoken">due %1$s</string>
    <string name="tasks_due_on_at_spoken">due %1$s at %2$s</string>
    <string name="tasks_not_done_spoken">not done</string>
    <string name="tasks_done_on_spoken">done on %1$s</string>
    <!-- What the tick box and a tap on a row do, as TalkBack offers them. -->
    <string name="tasks_mark_done">Mark as done</string>
    <string name="tasks_mark_not_done">Mark as not done</string>
    <string name="tasks_edit">Edit</string>

    <!-- Today. -->
    <string name="tasks_overdue">Overdue</string>
    <string name="tasks_nothing_due_today">Nothing due today.</string>
    <string name="tasks_add">Add a task</string>

    <!-- Lists. A row: "Home", with "4 open" at its end; TalkBack reads "Home, 4 open tasks". -->
    <plurals name="tasks_open_count">
        <item quantity="one">%1$s open</item>
        <item quantity="other">%1$s open</item>
    </plurals>
    <plurals name="tasks_open_count_spoken">
        <item quantity="one">%1$s open task</item>
        <item quantity="other">%1$s open tasks</item>
    </plurals>
    <string name="tasks_new_list">New list</string>
    <!-- Beside Lists from 840dp, while no list is open. -->
    <string name="tasks_choose_a_list">Choose a list.</string>

    <!-- The dialog of New list and Rename, with one field. -->
    <string name="tasks_rename_list">Rename list</string>
    <string name="tasks_name">Name</string>
    <string name="tasks_name_empty">Enter a name.</string>
    <plurals name="tasks_name_too_long">
        <item quantity="one">A name has at most %1$s character.</item>
        <item quantity="other">A name has at most %1$s characters.</item>
    </plurals>
    <plurals name="tasks_lists_limit">
        <item quantity="one">Tasks keeps %1$s list. Delete one to add another.</item>
        <item quantity="other">Tasks keeps %1$s lists. Delete one to add another.</item>
    </plurals>
    <string name="tasks_list_not_saved">Could not save the list. Try again.</string>

    <!-- One list. Its menu, its section of done tasks, and what it shows with no task. -->
    <string name="tasks_rename">Rename</string>
    <string name="tasks_delete_list">Delete list</string>
    <string name="tasks_delete_done">Delete done tasks</string>
    <string name="tasks_done">Done</string>
    <string name="tasks_list_empty_title">No tasks in this list.</string>
    <string name="tasks_list_empty_body">Tap Add a task to make one.</string>
    <!-- The question of Delete list: "Delete the list Home?", and "This deletes 12 tasks." or "The list is empty." -->
    <string name="tasks_delete_list_question">Delete the list %1$s?</string>
    <plurals name="tasks_delete_list_text">
        <item quantity="one">This deletes %1$s task.</item>
        <item quantity="other">This deletes %1$s tasks.</item>
    </plurals>
    <string name="tasks_delete_list_empty">The list is empty.</string>
    <!-- The question of Delete done tasks: "Delete 12 done tasks?" -->
    <plurals name="tasks_delete_done_question">
        <item quantity="one">Delete %1$s done task?</item>
        <item quantity="other">Delete %1$s done tasks?</item>
    </plurals>
    <string name="tasks_delete">Delete</string>
    <string name="tasks_cancel">Cancel</string>

    <!-- The task form, a bottom sheet. -->
    <string name="tasks_new_task">New task</string>
    <string name="tasks_edit_task">Edit task</string>
    <string name="tasks_title">Title</string>
    <!-- The list of the task, and the dialog that chooses it. -->
    <string name="tasks_list">List</string>
    <string name="tasks_due_date">Due date</string>
    <string name="tasks_no_due_date">No due date</string>
    <string name="tasks_add_due_date">Add a due date</string>
    <string name="tasks_remove">Remove</string>
    <string name="tasks_repeat">Repeat</string>
    <string name="tasks_days">Days</string>
    <!-- What the form gives for a repeat: "Dates: Wed 18 Nov, Fri 20 Nov, Mon 23 Nov, …". -->
    <string name="tasks_dates">Dates: %1$s</string>
    <string name="tasks_dates_more">%1$s, …</string>
    <!-- Days of the week, or dates, one after the other: "Mon, Wed, Fri". -->
    <string name="tasks_list_of_two">%1$s, %2$s</string>
    <string name="tasks_remind_me">Remind me</string>
    <string name="tasks_time">Time</string>
    <!-- For a done task: "Done on Mon 16 Nov." -->
    <string name="tasks_form_done_on">Done on %1$s.</string>
    <string name="tasks_save">Save</string>
    <!-- A row of the form with a value under its name is read as both: "List, Home". -->
    <string name="tasks_field_spoken">%1$s, %2$s</string>
    <string name="tasks_title_empty">Enter a title.</string>
    <plurals name="tasks_title_too_long">
        <item quantity="one">A title has at most %1$s character.</item>
        <item quantity="other">A title has at most %1$s characters.</item>
    </plurals>
    <string name="tasks_time_passed">That time has passed.</string>
    <string name="tasks_choose_a_day">Choose at least one day.</string>
    <plurals name="tasks_tasks_limit">
        <item quantity="one">Tasks keeps %1$s task. Delete it to add another.</item>
        <item quantity="other">Tasks keeps %1$s tasks. Delete some to add more.</item>
    </plurals>
    <!-- In the form, above its buttons, after a Save the database refused. The form is a sheet, where a snackbar would be hidden. -->
    <string name="tasks_task_not_saved">Could not save the task. Try again.</string>

    <!-- The snackbars. -->
    <string name="tasks_task_done">Task done</string>
    <!-- A repeating task moved to its next date: "Next: Wed 18 Nov". -->
    <string name="tasks_next">Next: %1$s</string>
    <string name="tasks_task_added">Task added</string>
    <string name="tasks_task_deleted">Task deleted</string>
    <string name="tasks_list_deleted">List deleted</string>
    <plurals name="tasks_done_deleted">
        <item quantity="one">%1$s task deleted</item>
        <item quantity="other">%1$s tasks deleted</item>
    </plurals>
    <string name="tasks_could_not_change">Could not change your tasks. Try again.</string>
    <string name="tasks_undo">Undo</string>

    <!-- What a screen shows when the database cannot be read. -->
    <string name="tasks_could_not_open">Could not open your tasks.</string>

    <!-- Settings. A row with a value under its name is read as both: "Recovery key, Not set up". -->
    <string name="tasks_setting_spoken">%1$s, %2$s</string>
    <string name="tasks_section_about">About</string>
    <string name="tasks_version">Version</string>
    <!-- When a backup was made, in the phone's long date format and its clock: "16 November 2026, 14:05". -->
    <string name="tasks_made_at">%1$s, %2$s</string>

    <!-- Backup, in Settings. The note is text, not a button; it shows only while the app has no recovery key. -->
    <string name="tasks_section_backup">Backup</string>
    <string name="tasks_backup_note_no_key">Backups are locked with a recovery key. You set it up when you make your first backup.</string>
    <string name="tasks_backup_note_unfinished">Finish setting up your recovery key to make backups.</string>
    <string name="tasks_make_backup">Make a backup</string>
    <string name="tasks_restore_backup">Restore a backup</string>

    <!-- Security, in Settings. Each row shows its state under its name. -->
    <string name="tasks_section_security">Security</string>
    <string name="tasks_recovery_key">Recovery key</string>
    <string name="tasks_recovery_key_not_set_up">Not set up</string>
    <string name="tasks_recovery_key_unfinished">Setup not finished</string>
    <string name="tasks_recovery_key_set_up">Set up</string>
    <string name="tasks_app_lock">App lock</string>
    <string name="tasks_app_lock_off">Off</string>
    <string name="tasks_app_lock_on">On</string>

    <!-- The dialogs of a backup and a restore. While it works, a progress circle with one of these three. -->
    <string name="tasks_backup_writing">Writing the backup</string>
    <string name="tasks_backup_checking">Checking the backup</string>
    <string name="tasks_backup_restoring">Restoring the backup</string>
    <string name="tasks_ok">OK</string>
    <!-- A backup is read again and checked right after it is written, as in Water. -->
    <string name="tasks_backup_written_title">Backup written</string>
    <plurals name="tasks_backup_written_text">
        <item quantity="one">The backup is written and checked. It holds %1$s task.</item>
        <item quantity="other">The backup is written and checked. It holds %1$s tasks.</item>
    </plurals>
    <string name="tasks_backup_not_usable_title">This backup cannot be used</string>
    <string name="tasks_backup_not_usable_text">Tasks wrote the file, but could not read it back as a whole backup. Make the backup again, in another place.</string>
    <string name="tasks_backup_not_checked_title">Backup written, not checked</string>
    <string name="tasks_backup_not_checked_text">The backup is written. Tasks could not read the file again to check it. To check it, choose Restore a backup, pick the file, and cancel at the question.</string>
    <string name="tasks_backup_not_written_title">The backup could not be written</string>
    <string name="tasks_backup_not_written_text">Writing the file failed, for example because the storage is full. If an unfinished file stays, delete it. It is never taken for a backup.</string>
    <string name="tasks_backup_no_keys_title">No backup was made</string>
    <string name="tasks_backup_no_keys_text">Tasks cannot use its keys now. Open Recovery key in Settings, then try again.</string>
    <!-- The question before a restore. The date and time are in the phone's format: "16 November 2026, 14:05". -->
    <string name="tasks_restore_question_title">Restore this backup?</string>
    <plurals name="tasks_restore_question_text">
        <item quantity="one">Made on %2$s. It holds %1$s task. A restore cannot undo a deletion or an edit you made after the backup.</item>
        <item quantity="other">Made on %2$s. It holds %1$s tasks. A restore cannot undo a deletion or an edit you made after the backup.</item>
    </plurals>
    <string name="tasks_restore">Restore</string>
    <string name="tasks_restored_title">Backup restored</string>
    <string name="tasks_restored_text">For every record, the newest edit stays.</string>
    <!-- When Tasks does not take a file: the answers of docs/user/backup.md. In each case nothing has changed. -->
    <string name="tasks_refused_not_a_backup_title">Not a backup</string>
    <string name="tasks_refused_not_a_backup_text">The file is something else, for example a photo. Pick the backup file. Nothing in Tasks has changed.</string>
    <string name="tasks_refused_newer_title">Made by a newer version of Tasks</string>
    <string name="tasks_refused_newer_text">The backup comes from a newer version of Tasks than the one on this phone. Update Tasks, then restore. Nothing in Tasks has changed.</string>
    <string name="tasks_refused_other_app_title">Backup of another app</string>
    <string name="tasks_refused_other_app_text">This is a backup of the app “%1$s”. Open the app the backup is from. Nothing in Tasks has changed.</string>
    <string name="tasks_refused_other_key_title">Needs another recovery key</string>
    <string name="tasks_refused_other_key_text">The backup was made with other recovery words than Tasks has. The short name of the key it needs is %1$s. Restore it in an app that is set up with those words. Nothing in Tasks has changed.</string>
    <string name="tasks_refused_no_keys_title">No keys</string>
    <string name="tasks_refused_no_keys_text">Tasks is not set up with a recovery key yet, or the phone was locked. Set up the recovery key, unlock the phone, and try again. Nothing in Tasks has changed.</string>
    <string name="tasks_refused_damaged_title">Damaged or changed</string>
    <string name="tasks_refused_damaged_text">The file is cut short or was changed. Use another copy of the backup. Nothing in Tasks has changed.</string>
    <string name="tasks_not_read_title">The file could not be read</string>
    <string name="tasks_not_read_text">Nothing in Tasks has changed. Try again.</string>
    <string name="tasks_no_room_title">Not enough room on the phone</string>
    <string name="tasks_no_room_text">A restore needs free room for about the size of the backup. Nothing in Tasks has changed.</string>
    <string name="tasks_unreadable_title">Tasks cannot read this backup</string>
    <string name="tasks_unreadable_text">It holds something this version of Tasks cannot read. Nothing in Tasks has changed.</string>

    <!-- Licences: every third-party part that ships in Tasks, and its notice and licence in full. -->
    <string name="tasks_licences">Licences</string>
    <string name="tasks_licences_intro">Tasks contains these parts made by others. Tap one to read its notice and its licence.</string>
    <string name="tasks_choose_a_part">Choose a part.</string>
    <string name="tasks_licence_notice">Notice</string>

    <!-- The line at the top of Today while an open task has a reminder to come and notifications cannot show, and its button. -->
    <string name="tasks_line_not_asked">Tasks may not show notifications yet.</string>
    <string name="tasks_line_denied">Notifications are off for Tasks. Your reminders are silent.</string>
    <string name="tasks_line_channel_off">Task reminders are turned off in Android\'s settings. Your reminders are silent.</string>
    <string name="tasks_allow">Allow</string>
    <string name="tasks_open_settings">Open settings</string>

    <!-- The dialog before Android's own question for notifications, after a save that sets a reminder. The title is Water's. -->
    <string name="tasks_question_title">Allow notifications</string>
    <string name="tasks_question_text">Tasks reminds you of a task with a notification. Android asks next whether Tasks may show notifications.</string>
    <string name="tasks_continue">Continue</string>
    <string name="tasks_not_now">Not now</string>

    <!-- The channel, as Android's settings show it. -->
    <string name="tasks_channel_name">Task reminders</string>
    <string name="tasks_channel_description">Shows a task\'s reminder at its time.</string>

    <!--
        The text of a task's notification. On time: "Due today", and the
        repeat after it: "Due today · Every day". Late: "Missed: 09:00", or
        "Missed: Mon 16 Nov, 09:00" when not today. After a snooze:
        "Snoozed. It was due at 09:00.", with the date in the same way.
    -->
    <string name="tasks_notification_due_today">Due today</string>
    <string name="tasks_date_at">%1$s, %2$s</string>
    <string name="tasks_missed">Missed: %1$s</string>
    <string name="tasks_snoozed_was_due">Snoozed. It was due at %1$s.</string>

    <!-- The two buttons of the notification. The snooze is fixed at 10 minutes. -->
    <string name="tasks_notification_done">Done</string>
    <plurals name="tasks_snooze_minutes">
        <item quantity="one">Snooze %1$s min</item>
        <item quantity="other">Snooze %1$s min</item>
    </plurals>
</resources>
