    <string name="water_drinks_today">Drinks today</string>
    <string name="water_drinks_of_day">Drinks</string>
    <string name="water_no_drinks_today">No drinks yet today.</string>
    <string name="water_no_drinks_on_day">No drinks on this day.</string>
    <!-- One drink: "14:05 · 250 ml", read "14:05, 250 millilitres". -->
    <string name="water_drink_row">%1$s · %2$s</string>
    <string name="water_drink_row_spoken">%1$s, %2$s</string>
    <!-- What a tap on a drink does, as TalkBack offers it. -->
    <string name="water_edit">Edit</string>

    <!-- The snackbars after a new drink and a delete. -->
    <string name="water_added">Added %1$s</string>
