    <!-- Reminders. The switch in Settings. -->
    <string name="water_remind_me">Remind me to drink</string>
    <!-- The reminder line of Today and Settings. The time is in the phone's format: "Next reminder at 14:30". -->
    <string name="water_reminder_next">Next reminder at %1$s</string>
    <string name="water_reminder_goal_reached">Goal reached. No more reminders today.</string>
    <string name="water_reminder_none_left">No more reminders today.</string>
    <string name="water_reminder_not_asked">Reminders are on, but Water may not show notifications yet.</string>
    <string name="water_reminder_denied">Notifications are off for Water. Reminders are silent.</string>
