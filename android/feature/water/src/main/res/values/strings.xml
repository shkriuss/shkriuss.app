<?xml version="1.0" encoding="utf-8"?>
<!--
    Every word of Water's screens (docs/apps/water/spec.md, "Screens").
    Amounts come as a number already in the phone's number format, such as
    "1,250", so the plurals take it as text and the number as the quantity.
    What TalkBack reads uses the full unit: "250 millilitres", not "250 ml".
-->
<resources>
    <!-- The three destinations. -->
    <string name="water_today">Today</string>
    <string name="water_history">History</string>
    <string name="water_settings">Settings</string>

    <!-- Amounts as shown, and the unit after a number field. -->
    <string name="water_amount_ml">%1$s ml</string>
    <string name="water_amount_fl_oz">%1$s fl oz</string>
    <string name="water_unit_ml">ml</string>
    <string name="water_unit_fl_oz">fl oz</string>

    <!-- Amounts as TalkBack reads them. -->
    <plurals name="water_amount_ml_spoken">
        <item quantity="one">%1$s millilitre</item>
        <item quantity="other">%1$s millilitres</item>
    </plurals>
    <plurals name="water_amount_fl_oz_spoken">
        <item quantity="one">%1$s fluid ounce</item>
        <item quantity="other">%1$s fluid ounces</item>
    </plurals>
    <!-- What TalkBack reads for the unit after a number field. -->
    <string name="water_unit_ml_spoken">millilitres</string>
    <string name="water_unit_fl_oz_spoken">fluid ounces</string>
    <plurals name="water_percent_spoken">
        <item quantity="one">%1$s percent</item>
        <item quantity="other">%1$s percent</item>
    </plurals>

    <!-- The summary of Today and of a day: "1,250 ml", then "of 2,000 ml · 62%". -->
    <string name="water_of_goal">of %1$s · %2$s%%</string>
    <string name="water_goal_reached">Goal reached</string>
    <!-- TalkBack reads the summary as one item: "1,250 of 2,000 millilitres today, 62 percent". -->
    <string name="water_summary_spoken_today">%1$s of %2$s today, %3$s</string>
    <string name="water_summary_spoken_day">%1$s of %2$s, %3$s</string>
    <!-- Added after the summary when the goal is met. -->
    <string name="water_summary_goal_reached_spoken">%1$s. Goal reached</string>
    <!-- The name of the progress bar. TalkBack reads it only where the bar is not part of the summary. -->
    <string name="water_progress_label">Share of the goal</string>

    <!-- Quick add on Today. The buttons show "+250 ml" and are read "Add 250 millilitres". -->
    <string name="water_quick_add">+%1$s</string>
    <string name="water_quick_add_spoken">Add %1$s</string>
    <string name="water_other_amount">Other amount</string>

