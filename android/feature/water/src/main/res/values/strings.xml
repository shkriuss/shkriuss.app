    <!-- A setting and its value, as TalkBack reads it: "Daily goal, 2,000 millilitres". -->
    <string name="water_setting_spoken">%1$s, %2$s</string>
    <string name="water_every">Every</string>
    <string name="water_every_30">30 minutes</string>
