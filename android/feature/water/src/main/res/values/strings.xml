    <string name="water_allow">Allow</string>
    <string name="water_open_settings">Open settings</string>
    <!-- The dialog before Android's own question for notifications. The owner chose the title. -->
    <string name="water_question_title">Allow notifications</string>
    <string name="water_question_text">Water reminds you with a notification. Android asks next whether Water may show notifications.</string>
    <string name="water_continue">Continue</string>
    <string name="water_not_now">Not now</string>

    <!-- The reminder itself. Its text: "1,250 of 2,000 ml today", in the unit in use. -->
    <string name="water_reminder_title">Time for some water</string>
    <string name="water_reminder_text">%1$s of %2$s today</string>
