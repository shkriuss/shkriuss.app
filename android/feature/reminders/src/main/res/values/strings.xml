<?xml version="1.0" encoding="utf-8"?>
<!--
    Every word of Reminders' screens (docs/apps/reminders/spec.md,
    "Screens"). Dates and times come already in the phone's format, such as
    "Wed 18 Nov" and "18:30", and counts in its number format, such as
    "1,250", so the plurals take them as text and the number as the
    quantity.
-->
<resources>
    <!-- The three destinations. -->
    <string name="reminders_upcoming">Upcoming</string>
    <string name="reminders_past">Past</string>
    <string name="reminders_settings">Settings</string>

    <!-- When a reminder shows: "Today, 09:00", "Tomorrow, 09:00", "Wed 18 Nov, 18:30". -->
    <string name="reminders_today_at">Today, %1$s</string>
    <string name="reminders_tomorrow_at">Tomorrow, %1$s</string>
    <string name="reminders_date_at">%1$s, %2$s</string>
    <!-- The same as TalkBack reads it: "today at 09:00", "Wednesday 18 November at 18:30". -->
    <string name="reminders_today_at_spoken">today at %1$s</string>
    <string name="reminders_tomorrow_at_spoken">tomorrow at %1$s</string>
    <string name="reminders_date_at_spoken">%1$s at %2$s</string>

    <!-- The repeats, as the form offers them and the rows show them. -->
    <string name="reminders_once">Once</string>
    <string name="reminders_every_day">Every day</string>
    <string name="reminders_every_week">Every week</string>
    <string name="reminders_every_month">Every month</string>
    <string name="reminders_every_year">Every year</string>
    <!-- The same as TalkBack reads them in a row: "Pills, tomorrow at 09:00, every day". -->
    <string name="reminders_every_day_spoken">every day</string>
    <string name="reminders_every_month_spoken">every month</string>
    <string name="reminders_every_year_spoken">every year</string>
    <!-- Days of the week in a row, one after the other: "Mon, Wed, Fri". -->
    <string name="reminders_day_list">%1$s, %2$s</string>

    <!-- Upcoming. One row: "Pills", then "Today, 09:00 · Every day". -->
    <string name="reminders_when_and_repeat">%1$s · %2$s</string>
    <string name="reminders_now">Now</string>
    <string name="reminders_snoozed_until">Snoozed until %1$s</string>
    <!-- One row as TalkBack reads it: "Pills, tomorrow at 09:00, every day", "Pills, snoozed until 09:12", "Call the bank, now". -->
    <string name="reminders_row_spoken">%1$s, %2$s</string>
    <string name="reminders_row_with_repeat_spoken">%1$s, %2$s, %3$s</string>
    <string name="reminders_now_spoken">now</string>
    <string name="reminders_snoozed_until_spoken">snoozed until %1$s</string>
    <!-- What a tap on a row does, as TalkBack offers it. -->
    <string name="reminders_edit">Edit</string>
    <string name="reminders_add">Add a reminder</string>
    <string name="reminders_upcoming_empty_title">No reminders yet.</string>
    <string name="reminders_upcoming_empty_body">Tap Add a reminder to make one.</string>

    <!-- Past. -->
    <string name="reminders_past_empty_title">No past reminders.</string>
    <string name="reminders_past_empty_body">A one-time reminder moves here after it shows.</string>
    <string name="reminders_delete_all">Delete all</string>
    <string name="reminders_delete_all_question">Delete all past reminders?</string>
    <plurals name="reminders_delete_all_text">
        <item quantity="one">This deletes %1$s reminder.</item>
        <item quantity="other">This deletes %1$s reminders.</item>
    </plurals>
    <plurals name="reminders_all_deleted">
        <item quantity="one">%1$s reminder deleted</item>
        <item quantity="other">%1$s reminders deleted</item>
    </plurals>

    <!-- Both lists from 840dp, beside the list while no form is open. -->
    <string name="reminders_choose_a_reminder">Choose a reminder.</string>

    <!-- The reminder form. -->
    <string name="reminders_new_reminder">New reminder</string>
    <string name="reminders_edit_reminder">Edit reminder</string>
    <string name="reminders_title">Title</string>
    <string name="reminders_repeat">Repeat</string>
    <string name="reminders_date">Date</string>
    <string name="reminders_days">Days</string>
    <string name="reminders_time">Time</string>
    <!-- What the form gives: "Next: Wed 18 Nov, 18:30". -->
    <string name="reminders_next">Next: %1$s</string>
    <string name="reminders_save">Save</string>
    <string name="reminders_cancel">Cancel</string>
    <string name="reminders_delete">Delete</string>
    <string name="reminders_title_empty">Enter a title.</string>
    <plurals name="reminders_title_too_long">
        <item quantity="one">A title has at most %1$s character.</item>
        <item quantity="other">A title has at most %1$s characters.</item>
    </plurals>
    <string name="reminders_time_passed">That time has passed.</string>
    <string name="reminders_choose_a_day">Choose at least one day.</string>
    <plurals name="reminders_limit">
        <item quantity="one">Reminders keeps %1$s reminder. Delete one to add another.</item>
        <item quantity="other">Reminders keeps %1$s reminders. Delete one to add another.</item>
    </plurals>

    <!-- The snackbars after a Save and a Delete in the form. -->
    <string name="reminders_saved">Reminder set for %1$s.</string>
    <string name="reminders_deleted">Reminder deleted</string>
    <string name="reminders_undo">Undo</string>

    <!-- Settings. A row with a value under its name is read as both: "Recovery key, Not set up". -->
    <string name="reminders_setting_spoken">%1$s, %2$s</string>
    <string name="reminders_section_about">About</string>
    <string name="reminders_version">Version</string>
    <!-- When a backup was made, in the phone's long date format and its clock: "16 November 2026, 14:05". -->
    <string name="reminders_made_at">%1$s, %2$s</string>

    <!-- Backup, in Settings. The note is text, not a button; it shows only while the app has no recovery key. -->
    <string name="reminders_section_backup">Backup</string>
    <string name="reminders_backup_note_no_key">Backups are locked with a recovery key. You set it up when you make your first backup.</string>
    <string name="reminders_backup_note_unfinished">Finish setting up your recovery key to make backups.</string>
    <string name="reminders_make_backup">Make a backup</string>
    <string name="reminders_restore_backup">Restore a backup</string>

    <!-- Security, in Settings. Each row shows its state under its name. -->
    <string name="reminders_section_security">Security</string>
    <string name="reminders_recovery_key">Recovery key</string>
    <string name="reminders_recovery_key_not_set_up">Not set up</string>
    <string name="reminders_recovery_key_unfinished">Setup not finished</string>
    <string name="reminders_recovery_key_set_up">Set up</string>
    <string name="reminders_app_lock">App lock</string>
    <string name="reminders_app_lock_off">Off</string>
    <string name="reminders_app_lock_on">On</string>

    <!-- The dialogs of a backup and a restore. While it works, a progress circle with one of these three. -->
    <string name="reminders_backup_writing">Writing the backup</string>
    <string name="reminders_backup_checking">Checking the backup</string>
    <string name="reminders_backup_restoring">Restoring the backup</string>
    <string name="reminders_ok">OK</string>
    <!-- A backup is read again and checked right after it is written, as in Water. -->
    <string name="reminders_backup_written_title">Backup written</string>
    <plurals name="reminders_backup_written_text">
        <item quantity="one">The backup is written and checked. It holds %1$s reminder.</item>
        <item quantity="other">The backup is written and checked. It holds %1$s reminders.</item>
    </plurals>
    <string name="reminders_backup_not_usable_title">This backup cannot be used</string>
    <string name="reminders_backup_not_usable_text">Reminders wrote the file, but could not read it back as a whole backup. Make the backup again, in another place.</string>
    <string name="reminders_backup_not_checked_title">Backup written, not checked</string>
    <string name="reminders_backup_not_checked_text">The backup is written. Reminders could not read the file again to check it. To check it, choose Restore a backup, pick the file, and cancel at the question.</string>
    <string name="reminders_backup_not_written_title">The backup could not be written</string>
    <string name="reminders_backup_not_written_text">Writing the file failed, for example because the storage is full. If an unfinished file stays, delete it. It is never taken for a backup.</string>
    <string name="reminders_backup_no_keys_title">No backup was made</string>
    <string name="reminders_backup_no_keys_text">Reminders cannot use its keys now. Open Recovery key in Settings, then try again.</string>
    <!-- The question before a restore. The date and time are in the phone's format: "16 November 2026, 14:05". -->
    <string name="reminders_restore_question_title">Restore this backup?</string>
    <plurals name="reminders_restore_question_text">
        <item quantity="one">Made on %2$s. It holds %1$s reminder. A restore cannot undo a deletion or an edit you made after the backup.</item>
        <item quantity="other">Made on %2$s. It holds %1$s reminders. A restore cannot undo a deletion or an edit you made after the backup.</item>
    </plurals>
    <string name="reminders_restore">Restore</string>
    <string name="reminders_restored_title">Backup restored</string>
    <string name="reminders_restored_text">For every record, the newest edit stays.</string>
    <!-- When Reminders does not take a file: the answers of docs/user/backup.md. In each case nothing has changed. -->
    <string name="reminders_refused_not_a_backup_title">Not a backup</string>
    <string name="reminders_refused_not_a_backup_text">The file is something else, for example a photo. Pick the backup file. Nothing in Reminders has changed.</string>
    <string name="reminders_refused_newer_title">Made by a newer version of Reminders</string>
    <string name="reminders_refused_newer_text">The backup comes from a newer version of Reminders than the one on this phone. Update Reminders, then restore. Nothing in Reminders has changed.</string>
    <string name="reminders_refused_other_app_title">Backup of another app</string>
    <string name="reminders_refused_other_app_text">This is a backup of the app “%1$s”. Open the app the backup is from. Nothing in Reminders has changed.</string>
    <string name="reminders_refused_other_key_title">Needs another recovery key</string>
    <string name="reminders_refused_other_key_text">The backup was made with other recovery words than Reminders has. The short name of the key it needs is %1$s. Restore it in an app that is set up with those words. Nothing in Reminders has changed.</string>
    <string name="reminders_refused_no_keys_title">No keys</string>
    <string name="reminders_refused_no_keys_text">Reminders is not set up with a recovery key yet, or the phone was locked. Set up the recovery key, unlock the phone, and try again. Nothing in Reminders has changed.</string>
    <string name="reminders_refused_damaged_title">Damaged or changed</string>
    <string name="reminders_refused_damaged_text">The file is cut short or was changed. Use another copy of the backup. Nothing in Reminders has changed.</string>
    <string name="reminders_not_read_title">The file could not be read</string>
    <string name="reminders_not_read_text">Nothing in Reminders has changed. Try again.</string>
    <string name="reminders_no_room_title">Not enough room on the phone</string>
    <string name="reminders_no_room_text">A restore needs free room for about the size of the backup. Nothing in Reminders has changed.</string>
    <string name="reminders_unreadable_title">Reminders cannot read this backup</string>
    <string name="reminders_unreadable_text">It holds something this version of Reminders cannot read. Nothing in Reminders has changed.</string>

    <!-- Licences: every third-party part that ships in Reminders, and its notice and licence in full. -->
    <string name="reminders_licences">Licences</string>
    <string name="reminders_licences_intro">Reminders contains these parts made by others. Tap one to read its notice and its licence.</string>
    <string name="reminders_choose_a_part">Choose a part.</string>
    <string name="reminders_licence_notice">Notice</string>
    <string name="reminders_licence_text">Licence</string>

    <!-- The line at the top of Upcoming while a reminder is upcoming and notifications cannot show, and its button. -->
    <string name="reminders_line_not_asked">Reminders may not show notifications yet.</string>
    <string name="reminders_line_denied">Notifications are off for Reminders. Your reminders are silent.</string>
    <string name="reminders_line_channel_off">Reminders are turned off in Android\'s settings. Your reminders are silent.</string>
    <string name="reminders_allow">Allow</string>
    <string name="reminders_open_settings">Open settings</string>

    <!-- The dialog before Android's own question for notifications. The title is Water's, which the owner chose. -->
    <string name="reminders_question_title">Allow notifications</string>
    <string name="reminders_question_text">Reminders shows each reminder as a notification. Android asks next whether Reminders may show notifications.</string>
    <string name="reminders_continue">Continue</string>
    <string name="reminders_not_now">Not now</string>

    <!-- The channel, as Android's settings show it. -->
    <string name="reminders_channel_name">Reminders</string>
    <string name="reminders_channel_description">Shows each reminder at its time.</string>

    <!--
        The text of a reminder's notification. On time, its repeat: "Every
        day", "Every Mon, Wed, Fri", or none for Once. Late: "Missed: 09:00",
        or "Missed: Mon 16 Nov, 09:00" when not today. After a snooze:
        "Snoozed. It was due at 09:00.", with the date in the same way.
    -->
    <string name="reminders_every_days">Every %1$s</string>
    <string name="reminders_missed">Missed: %1$s</string>
    <string name="reminders_snoozed_was_due">Snoozed. It was due at %1$s.</string>

    <!-- The two buttons of the notification. The snooze is fixed at 10 minutes. -->
    <string name="reminders_done">Done</string>
    <plurals name="reminders_snooze_minutes">
        <item quantity="one">Snooze %1$s min</item>
        <item quantity="other">Snooze %1$s min</item>
    </plurals>
</resources>
