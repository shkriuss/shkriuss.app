// Cloudflare Worker for this app: the static site, plus /api/sync/* for
// syncing between devices with the optional account (docs/adr/0010-account-and-sync.md).
// Docs: docs/deployment.md
{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "tally",
  "compatibility_date": "2026-10-01",
  "main": "src/worker.ts",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    // Only /api/* runs the Worker code; every other request is a static file.
    "run_worker_first": ["/api/*"],
    "not_found_handling": "404-page",
    "html_handling": "auto-trailing-slash",
  },
  // One store per account: its sealed copy of Tally's data. SQLite-backed,
  // as the free plan requires.
  "durable_objects": {
    "bindings": [{ "name": "SYNC_COPIES", "class_name": "SyncCopy" }],
  },
  "migrations": [{ "tag": "sync-v1", "new_sqlite_classes": ["SyncCopy"] }],
  // The real address. Cloudflare creates the DNS record and certificate.
  "routes": [{ "pattern": "tally.shkriuss.app", "custom_domain": true }],
  // Only at the real address: no *.workers.dev address, and no addresses for
  // single versions either (docs/adr/0019-no-pull-request-previews.md).
  // No Workers logs or traces: nothing about requests is kept (see the privacy page).
  "observability": { "enabled": false },
  "workers_dev": false,
  "preview_urls": false,
}
