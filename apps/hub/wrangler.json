{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "shkriuss-hub",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application"
  },
  "workers_dev": false,
  "preview_urls": false,
  "send_metrics": false,
  "env": {
    "staging": {
      "name": "shkriuss-hub-staging",
      "routes": [{ "pattern": "shkriuss.dev", "custom_domain": true }],
      "workers_dev": false,
      "preview_urls": false
    },
    "production": {
      "name": "shkriuss-hub-production",
      "routes": [{ "pattern": "shkriuss.app", "custom_domain": true }],
      "workers_dev": false,
      "preview_urls": false
    }
  }
}
