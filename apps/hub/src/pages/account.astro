---
/**
 * The optional shkriuss account (docs/adr/0010-account-and-sync.md): create
 * one, save the recovery key, sign in with it or a passkey, add devices with
 * a QR code, turn sync on and off in apps, replace the key after losing a device,
 * sign out. Behaviour: ../scripts/account.ts. One view is shown at a time
 * (data-view); the script picks it.
 */
import { hub, listedApps } from '@shkriuss/registry';
import { AppShell, Button } from '@shkriuss/ui';

const syncApps = listedApps.filter((app) => app.sync === true);
// Their reminders while closed aren't tied to the account (audit 3 A-1).
const pushApps = listedApps.filter((app) => app.pushNotifications === true);
---

<AppShell
  title="Account"
  description="An optional shkriuss account to keep your apps in sync, end-to-end encrypted."
>
  <div class="stack stack--lg" data-account>
    <section class="stack" aria-labelledby="account-heading">
      <h1 id="account-heading">Your shkriuss account</h1>
      <p class="lead">
        Optional. Keep your apps the same on your phone, tablet and computer. Everything is locked
        on your devices before it's sent, so only your devices can read it.
      </p>
      <p class="muted">
        To sync an app, open it and tap “Turn on sync”. Each app gets its own key from your account,
        never the account itself.
      </p>
    </section>

    <p class="visually-hidden" role="status" data-announcer></p>
    <p class="notice" role="status" data-message hidden></p>

    <p class="muted" data-view="loading">
      Loading…
    </p>
    <noscript>
      <p class="notice">The account needs JavaScript, which is turned off in this browser.</p>
    </noscript>

    <section class="stack" aria-labelledby="start-heading" data-view="signed-out" hidden>
      <p class="notice" data-connect-note hidden>
        To sync <span data-connect-app></span>, sign in or create an account first.
      </p>
      <h2 id="start-heading" tabindex="-1">
        Create an account
      </h2>
      <p>
        No email, no password, no name. Your account is a key that only your devices have, and a
        recovery key that you keep.
      </p>
      <p>
        <Button variant="primary" icon="plus" data-action="create">
          Create an account
        </Button>
      </p>
      <h2>Already have one?</h2>
      <div class="cluster">
        <Button icon="key" data-action="passkey-sign-in" data-needs-passkey>
          Sign in with a passkey
        </Button>
        <Button data-action="show-recovery-form">Use my recovery key</Button>
      </div>
      <p class="muted">
        Or add this device from one that's signed in: open this page there, tap “Show a code”, and
        scan the code with this device's camera.
      </p>
    </section>

    <section class="stack" aria-labelledby="recovery-heading" data-view="recovery" hidden>
      <h2 id="recovery-heading" tabindex="-1">
        Sign in with your recovery key
      </h2>
      <form class="stack" data-recovery-form novalidate>
        <div class="field">
          <label class="field__label" for="recovery-key">
            Recovery key
          </label>
          <p class="field__hint" id="recovery-key-hint">
            56 letters and digits, in groups of 4. Spaces and dashes don't matter.
          </p>
          <textarea
            dir="auto"
            class="input recovery-input"
            id="recovery-key"
            name="key"
            rows="3"
            autocomplete="off"
            autocapitalize="characters"
            autocorrect="off"
            spellcheck="false"
            aria-describedby="recovery-key-hint recovery-key-error"
          ></textarea>
          <p class="field__error" id="recovery-key-error" data-error-for="key"></p>
        </div>
        <div class="cluster">
          <Button type="submit" variant="primary">
            Sign in
          </Button>
          <Button data-action="back">Back</Button>
        </div>
      </form>
    </section>

    <section class="stack" aria-labelledby="new-heading" data-view="new" hidden>
      <h2 id="new-heading" tabindex="-1" data-new-title>
        Save your recovery key
      </h2>
      <p>
        This is the key to your account. With it you can sign in on any device. Keep it somewhere
        safe: a password manager is best. You can also download it, or write it down.
      </p>
      <p class="muted">
        On an iPhone or iPad, a download usually goes to iCloud Drive, where Apple can read it
        unless you've turned on Advanced Data Protection. A password manager or paper is safer
        there.
      </p>
      <p class="notice notice--danger">
        If you lose it and every signed-in device, nobody can get your account back, not even us.
      </p>
      {/* Only while the service keeps its note (audit 7 D-3; audit 7 A-4, run 27). */}
      <p class="notice" data-replace-only hidden>
        When you continue, your old recovery key and passkeys can't sign in any more, for as long as
        the account service keeps its note about the old key.
      </p>
      <p class="code-text" data-new-key></p>
      <div class="cluster">
        <Button icon="download" data-action="download-key">
          Download recovery key
        </Button>
        <Button icon="copy" data-action="copy-key">
          Copy
        </Button>
      </div>
      <p class="muted" role="status" data-new-status></p>
      <label class="check">
        <input type="checkbox" data-saved-check />
        <span>I've saved my recovery key</span>
      </label>
      <div class="cluster">
        <Button variant="primary" data-action="finish-create" disabled>
          <span data-finish-label>Continue</span>
        </Button>
        <Button data-action="back">Cancel</Button>
      </div>
    </section>

    <section class="stack" aria-labelledby="replace-heading" data-view="replace" hidden>
      <h2 id="replace-heading" tabindex="-1">
        Replace your account key?
      </h2>
      <p>
        Do this if a signed-in phone, tablet or computer was lost or stolen, or if someone else saw
        your recovery key.
      </p>
      <ul>
        <li>
          You get a new recovery key. The old one, and your passkeys, can't sign in any more, for as
          long as the account service keeps its note about the old key: until no device has tried it
          for 13 months. A passkey can still unlock the old key, though: remove them afterwards with
          “Remove a passkey”.
        </li>
        <li>
          Devices with the old key are signed out when they next open this page. Their apps keep
          syncing until you turn on sync again in each app (next point).
        </li>
        <li>
          Then turn on sync again in each app. Your synced data moves to the new key, and the old
          online copies are deleted.
        </li>
        <li>
          If the lost device has your password manager, remove the device from it too (for example
          in your Google or Apple account) before you add a new passkey.
        </li>
        {pushApps.length > 0 && (
          <li>
            Reminders while an app is closed aren't part of your account, so they keep reaching the
            lost device (an Android lock screen shows their titles) until it's erased, its browser
            stops allowing the app's notifications, or the app hasn't been opened on it for 13
            months. Erase or lock it remotely if you can (Find My on Apple devices, Find My Device
            on Android): erasing it stops them.
          </li>
        )}
      </ul>
      <p class="notice">
        Anything synced before now could already have been seen on the lost device. Replacing the
        key protects what you do from now on.
      </p>
      <div class="cluster">
        <Button variant="danger" data-action="start-replace">
          Get a new key
        </Button>
        <Button data-action="back">Cancel</Button>
      </div>
    </section>

    <section class="stack" aria-labelledby="link-heading" data-view="link-confirm" hidden>
      <h2 id="link-heading" tabindex="-1">
        Add this device to your account?
      </h2>
      <p>
        Account code: <strong class="account-code" data-link-code></strong>. Check that your other
        device shows the same code.
      </p>
      <p class="notice">
        Only continue if you just showed this code on your own device. If someone else sent you the
        link, they could see what you sync.
      </p>
      <p class="notice notice--danger" data-link-replace hidden>
        This device is signed in to a different account now. Continuing signs it in to this one
        instead.
      </p>
      <div class="cluster">
        <Button variant="primary" data-action="accept-link">
          Add this device
        </Button>
        <Button data-action="back">Cancel</Button>
      </div>
    </section>

    <section class="stack" aria-labelledby="connect-heading" data-view="connect" hidden>
      <h2 id="connect-heading" tabindex="-1">
        Sync <span data-connect-app></span> with your account?
      </h2>
      <p>
        <span data-connect-app></span> will keep its data the same on every device where you turn on
        sync. It's locked on your devices before it's sent, so only they can read it. The app gets
        its own key from your account, not the account itself.
      </p>
      <p>
        Account code: <strong class="account-code" data-connect-code></strong>
      </p>
      <div class="cluster">
        <Button variant="primary" data-action="accept-connect">
          <span>
            Turn on sync for <span data-connect-app></span>
          </span>
        </Button>
        <Button data-action="cancel-connect">Cancel</Button>
      </div>
    </section>

    <section
      class="stack stack--lg"
      aria-labelledby="signed-in-heading"
      data-view="signed-in"
      hidden
    >
      <div class="stack">
        <h2 id="signed-in-heading" tabindex="-1">
          This device is signed in
        </h2>
        <p>
          Account code: <strong class="account-code" data-account-code></strong>
        </p>
        <p class="muted">Every device on your account shows this same code.</p>
      </div>

      {syncApps.length > 0 && (
        <section class="stack" aria-labelledby="sync-apps-heading">
          <h3 id="sync-apps-heading">Apps that sync</h3>
          <p>
            Turn sync on or off in each app, on each device. These open the app and do it there.
            Turning on asks you to confirm here first.
          </p>
          <ul role="list" class="cluster">
            {syncApps.map((app) => (
              <li>
                <Button
                  href={`https://${app.slug}.${hub.domain}/#sync=connect`}
                  data-sync-app={app.slug}
                >
                  Turn on sync in {app.name}
                </Button>
              </li>
            ))}
          </ul>
          <p class="muted">
            Turned sync off inside an app? This page can't see into apps, so it still says “Turn
            off” there until you tap it.
          </p>
        </section>
      )}

      <section class="stack" aria-labelledby="add-device-heading">
        <h3 id="add-device-heading">Add a device</h3>
        <p>
          Sign in on another phone, tablet or computer without typing anything: show a code here,
          then scan it with the other device's camera.
        </p>
        <p>
          <Button icon="qr" data-action="create-link">
            Show a code
          </Button>
        </p>
        <div class="stack" data-link-panel hidden>
          <div data-link-qr></div>
          <p>Or open this link on the other device:</p>
          <p class="code-text link-text" data-link-url></p>
          <div class="cluster">
            <Button icon="copy" data-action="copy-link">
              Copy link
            </Button>
            <Button data-action="close-link">Done</Button>
          </div>
          <p class="muted">
            The code is drawn on this device, by code that follows{' '}
            <a href="/licenses/qrcodegen.txt">Project Nayuki’s QR Code generator</a>.
          </p>
        </div>
        <p class="muted" role="status" data-link-status></p>
      </section>

      <section class="stack" aria-labelledby="passkeys-heading">
        <h3 id="passkeys-heading">Passkeys</h3>
        <p>
          A passkey signs you in with your fingerprint, face or screen lock. Your password manager
          (Google, Apple or another) keeps it, and your other devices with the same password manager
          can use it too.
        </p>
        <p class="muted">
          To stop using one, tap “Remove a passkey” here before you delete it from your password
          manager: only the passkey can remove what the server keeps for it (your account key,
          locked).
        </p>
        <div class="cluster" data-needs-passkey>
          <Button icon="key" data-action="add-passkey">
            Add a passkey
          </Button>
          <Button variant="ghost" data-action="remove-passkey">
            Remove a passkey
          </Button>
        </div>
        <p class="muted" role="status" data-passkey-status></p>
      </section>

      <section class="stack" aria-labelledby="key-heading">
        <h3 id="key-heading">Recovery key</h3>
        <p>Lost it? You can see it again here, on any signed-in device.</p>
        <p>
          <Button data-action="show-key">Show recovery key</Button>
        </p>
      </section>

      <section class="stack" aria-labelledby="replace-key-heading">
        <h3 id="replace-key-heading">Lost a device?</h3>
        <p>
          If a signed-in device is lost or stolen, replace your account key. That signs out every
          device with the old key when it next opens this page. Each app stops syncing with the old
          key once you turn on sync in it again, with the links above: do that for every app, on
          each of your devices. Until then, the lost device can still see that app's changes.
          {pushApps.length > 0 &&
            " Reminders while an app is closed keep reaching it until it's erased."}
        </p>
        <p>
          <Button data-action="replace">Replace the account key</Button>
        </p>
      </section>

      <section class="stack" aria-labelledby="sign-out-heading">
        <h3 id="sign-out-heading">Sign out</h3>
        <p>Signs out this device only. Your account and your other devices stay as they are.</p>
        <p>
          <Button variant="danger" icon="log-out" data-action="sign-out">
            Sign out of this device
          </Button>
        </p>
      </section>
    </section>

    <dialog
      class="dialog"
      aria-labelledby="key-dialog-title"
      aria-describedby="key-dialog-note"
      data-key-dialog
    >
      <div class="stack">
        <h2 id="key-dialog-title">Your recovery key</h2>
        <p class="notice notice--danger" id="key-dialog-note">
          Anyone who sees it can sign in to your account. Don't share it or post it.
        </p>
        <p class="code-text" data-dialog-key></p>
        <div class="cluster">
          <Button icon="download" data-action="download-account-key">
            Download
          </Button>
          <Button icon="copy" data-action="copy-account-key">
            Copy
          </Button>
          <Button data-action="close-dialog">Close</Button>
        </div>
        <p class="muted" role="status" data-dialog-status></p>
      </div>
    </dialog>

    {/* What it means is read out with the question (aria-describedby; the script adds the apps' paragraph when it's shown: audit 5 G-3). */}
    <dialog
      class="dialog"
      aria-labelledby="sign-out-title"
      aria-describedby="sign-out-description"
      data-sign-out-dialog
    >
      <form method="dialog" class="stack">
        <h2 id="sign-out-title">Sign out of this device?</h2>
        <p id="sign-out-description">
          To sign in again you'll need your recovery key, a passkey, or a code from another
          signed-in device.
        </p>
        <p id="sign-out-apps" data-sign-out-apps hidden>
          Apps on this device keep syncing after you sign out. To stop that, cancel, and use the
          "Turn off sync in …" links on this page first: <span data-sign-out-app-names></span>.
        </p>
        <div class="cluster">
          <Button type="submit" value="cancel">
            Cancel
          </Button>
          <Button type="submit" variant="danger" value="confirm">
            Sign out
          </Button>
        </div>
      </form>
    </dialog>
  </div>
</AppShell>

<script>
  import { mountAccount } from '../scripts/account.ts';

  const root = document.querySelector<HTMLElement>('[data-account]');
  if (root) void mountAccount(root);
</script>

<style>
  .account-code {
    font-family: var(--font-mono);
    letter-spacing: 0.04em;
  }

  .recovery-input {
    font-family: var(--font-mono);
    text-transform: uppercase;
  }

  .link-text {
    font-size: var(--text-sm);
  }
</style>
