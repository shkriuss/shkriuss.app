// Cloudflare Worker for the hub: the static site, plus /api/account/* for the
// optional shkriuss account (docs/adr/0010-account-and-sync.md).
// Docs: docs/deployment.md
{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "hub",
  "compatibility_date": "2026-10-01",
  "main": "src/worker.ts",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    // Only /api/* runs the Worker code; every other request is a static file.
    "run_worker_first": ["/api/*"],
    "not_found_handling": "404-page",
    "html_handling": "auto-trailing-slash",
  },
  // One store per device link (deleted after 10 minutes), one per passkey
  // lock, and one per replaced account key. SQLite-backed, as the free plan
  // requires.
  "durable_objects": {
    "bindings": [
      { "name": "ACCOUNT_LINKS", "class_name": "AccountLink" },
      { "name": "ACCOUNT_PASSKEYS", "class_name": "AccountPasskey" },
      { "name": "ACCOUNT_STATUS", "class_name": "AccountStatus" },
    ],
  },
  "migrations": [
    { "tag": "account-v1", "new_sqlite_classes": ["AccountLink", "AccountPasskey"] },
    { "tag": "account-v2", "new_sqlite_classes": ["AccountStatus"] },
  ],
  // The real address. Cloudflare creates the DNS record and certificate.
  "routes": [{ "pattern": "shkriuss.app", "custom_domain": true }],
  // No *.workers.dev address for production, but keep preview links for PRs.
  // No Workers logs or traces: nothing about requests is kept (see the privacy page).
  "observability": { "enabled": false },
  "workers_dev": false,
  "preview_urls": true,
  // Settings for PR previews (`wrangler preview`). Each preview gets its own,
  // empty Durable Object storage: nothing is shared with the real site.
  "previews": {
    "durable_objects": {
      "bindings": [
        { "name": "ACCOUNT_LINKS", "class_name": "AccountLink" },
        { "name": "ACCOUNT_PASSKEYS", "class_name": "AccountPasskey" },
        { "name": "ACCOUNT_STATUS", "class_name": "AccountStatus" },
      ],
    },
  },
}
