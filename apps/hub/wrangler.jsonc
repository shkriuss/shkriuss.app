// Cloudflare Worker for the hub: the static site, plus /api/account/* for the
// optional shkriuss account (docs/adr/0010-account-and-sync.md).
// Docs: docs/deployment.md
{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "hub",
  "compatibility_date": "2026-10-01",
  "main": "src/worker.ts",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    // Only /api/* runs the Worker code; every other request is a static file.
    "run_worker_first": ["/api/*"],
    "not_found_handling": "404-page",
    "html_handling": "auto-trailing-slash",
  },
  // One store per device link (deleted after 10 minutes) and one per passkey
  // lock. SQLite-backed, as the free plan requires.
  "durable_objects": {
    "bindings": [
      { "name": "ACCOUNT_LINKS", "class_name": "AccountLink" },
      { "name": "ACCOUNT_PASSKEYS", "class_name": "AccountPasskey" },
    ],
  },
  "migrations": [{ "tag": "account-v1", "new_sqlite_classes": ["AccountLink", "AccountPasskey"] }],
  // The real address. Cloudflare creates the DNS record and certificate.
  "routes": [{ "pattern": "shkriuss.app", "custom_domain": true }],
  // No *.workers.dev address for production, but keep preview links for PRs.
  "workers_dev": false,
  "preview_urls": true,
  // Settings for PR previews (`wrangler preview`). Each preview gets its own,
  // empty Durable Object storage: nothing is shared with the real site.
  "previews": {
    "durable_objects": {
      "bindings": [
        { "name": "ACCOUNT_LINKS", "class_name": "AccountLink" },
        { "name": "ACCOUNT_PASSKEYS", "class_name": "AccountPasskey" },
      ],
    },
  },
}
