---
import { AppShell, Button, DataControls, Icon, PushControls, SyncControls } from '@shkriuss/ui';
import { MAX_NOTES_LENGTH, MAX_TITLE_LENGTH, REPEAT_LABELS, REPEATS } from '../lib/events.ts';
---

<AppShell wide>
  <h1 class="visually-hidden">Calendar</h1>

  <div class="stack stack--lg">
    <!-- Reminders that are due: shown while Calendar is open. -->
    <section class="notice stack stack--sm due" aria-labelledby="due-heading" data-due hidden>
      <h2 id="due-heading" class="due__title">
        <Icon name="bell" />
        Reminders
      </h2>
      <ul role="list" class="event-list" data-due-list></ul>
      <p>
        <Button data-action="dismiss-reminders">Dismiss</Button>
      </p>
    </section>

    <div class="calendar-layout">
      <section class="stack month" aria-labelledby="month-heading">
        <div class="cluster cluster--between">
          <h2 id="month-heading" class="month__title" aria-live="polite" data-month-title>
            Calendar
          </h2>
          <div class="cluster month__nav">
            <Button icon="chevron-left" label="Previous month" data-action="prev-month" />
            <Button data-action="today">Today</Button>
            <Button icon="chevron-right" label="Next month" data-action="next-month" />
          </div>
        </div>

        <table class="month__grid" aria-labelledby="month-heading">
          <thead>
            <tr data-weekdays></tr>
          </thead>
          <tbody data-weeks></tbody>
        </table>
        <!-- What the marks on days mean (each shown while its kind is shown). -->
        <p class="cluster muted month__legend" data-special-legend>
          <span class="legend" data-legend="daysOff">
            <span class="legend__off" aria-hidden="true">
              17
            </span>
            Day off
          </span>
          <span class="legend" data-legend="feasts">
            <span class="legend__ring" aria-hidden="true"></span>
            Orthodox holiday
          </span>
          <span class="legend" data-legend="fasts">
            <span class="legend__fast" aria-hidden="true"></span>
            Fast
          </span>
        </p>
        <p class="muted month__hint">
          Tip: with a keyboard, use the arrow keys to move between days, and Page Up or Page Down to
          change month.
        </p>
      </section>

      <div class="stack stack--lg">
        <section class="stack" aria-labelledby="day-heading">
          <div class="cluster cluster--between">
            <h2 id="day-heading" data-day-heading>
              Today
            </h2>
            <Button variant="primary" icon="plus" data-action="new-event">
              New event
            </Button>
          </div>
          <ul role="list" class="event-list" data-day-special></ul>
          <ul role="list" class="event-list" data-day-events></ul>
          <p class="muted" data-day-empty>
            Nothing planned on this day.
          </p>
        </section>

        <section class="stack" aria-labelledby="upcoming-heading">
          <h2 id="upcoming-heading">Next 7 days</h2>
          <ul role="list" class="event-list" data-upcoming></ul>
          <p class="muted" data-upcoming-empty>
            Nothing planned in the next 7 days.
          </p>
        </section>
      </div>
    </div>

    <section class="stack" aria-labelledby="special-heading">
      <h2 id="special-heading">Holidays and fasts</h2>
      <fieldset class="stack stack--sm">
        <legend class="field__label">Show on the calendar</legend>
        <label class="check">
          <input type="checkbox" data-special-setting="daysOff" />
          <span>Days off in Georgia (public holidays)</span>
        </label>
        <label class="check">
          <input type="checkbox" data-special-setting="feasts" />
          <span>Orthodox holidays</span>
        </label>
        <label class="check">
          <input type="checkbox" data-special-setting="fasts" />
          <span>Fasts</span>
        </label>
        <label class="check special-weekly">
          <input type="checkbox" data-special-setting="weeklyFasts" />
          <span>Every Wednesday and Friday too</span>
        </label>
      </fieldset>
      <p class="muted">
        Days off are the public holidays in Georgia’s Labour Code. The government sometimes adds
        others, for example on election days: those aren’t shown. Orthodox holidays and fasts follow
        the Georgian Orthodox Church’s calendar.
      </p>
    </section>

    <section class="stack" aria-labelledby="notifications-heading">
      <h2 id="notifications-heading">Notifications</h2>
      <p data-notify-status>Reminders show on this page while Calendar is open.</p>
      <p data-notify-enable hidden>
        <Button icon="bell" data-action="enable-notifications">
          Turn on notifications
        </Button>
      </p>
      <p class="muted">
        With sync on, your reminders are the same on all your devices. Each device reminds you once
        notifications are turned on there.
      </p>
      <PushControls />
    </section>

    <section class="stack" aria-labelledby="transfer-heading">
      <h2 id="transfer-heading">Import and export</h2>
      <p class="muted">
        Move events between Calendar and other calendar apps, like Google Calendar, Apple Calendar
        and Outlook, with .ics files.
      </p>
      <div class="cluster">
        <Button icon="upload" data-action="import-ics">
          Import .ics file
        </Button>
        <Button icon="download" data-action="export-ics">
          Download .ics file
        </Button>
      </div>
      <p class="muted" role="status" data-export-status></p>
      <input
        type="file"
        accept=".ics,text/calendar"
        aria-label="Choose an .ics file to import"
        hidden
        data-import-file
      />
    </section>

    <SyncControls />

    <DataControls />
  </div>

  <p class="visually-hidden" role="status" data-announcer></p>

  <!-- One event in a list, copied by the script for each event. Its accessible
       name ("9:00 AM – 10:00 AM, Dentist, repeats, with a reminder") is set by the script. -->
  <template data-event-template>
    <li>
      <button type="button" class="event-item" data-action="edit">
        <span class="event-item__when" data-when></span>
        <span dir="auto" class="event-item__title" data-title>
          Event
        </span>
        <span class="event-item__icons">
          <span data-repeat hidden>
            <Icon name="repeat" />
          </span>
          <span data-has-reminder hidden>
            <Icon name="bell" />
          </span>
        </span>
      </button>
    </li>
  </template>

  <!-- A holiday or fast in a list, copied by the script. -->
  <template data-special-template>
    <li class="special-item">
      <span class="special-item__kind" data-kind>
        Day off
      </span>
      <span class="special-item__name" data-name>
        Holiday
      </span>
      <span class="special-item__local" lang="ka" data-name-ka></span>
    </li>
  </template>

  <dialog class="dialog" aria-labelledby="event-dialog-title" data-event-dialog>
    <form class="stack" data-event-form novalidate>
      <h2 id="event-dialog-title" data-dialog-title>
        New event
      </h2>
      <p class="muted" data-repeat-note hidden>
        This event repeats. Changes apply to every time it happens.
      </p>
      <p class="notice" data-gone-note hidden></p>

      <div class="field">
        <label class="field__label" for="event-title">
          Title
        </label>
        <input
          dir="auto"
          class="input"
          id="event-title"
          name="title"
          type="text"
          autocomplete="off"
          maxlength={MAX_TITLE_LENGTH}
          aria-describedby="event-title-error"
          required
        />
        <p class="field__error" id="event-title-error" data-error-for="title"></p>
      </div>

      <label class="check">
        <input type="checkbox" name="allDay" />
        <span>All day</span>
      </label>

      <div class="field-row">
        <div class="field">
          <label class="field__label" for="event-start-date">
            Starts
          </label>
          <input
            class="input"
            id="event-start-date"
            name="startDate"
            type="date"
            aria-describedby="event-start-date-error"
            required
          />
          <p class="field__error" id="event-start-date-error" data-error-for="startDate"></p>
        </div>
        <div class="field" data-time-field>
          <label class="field__label" for="event-start-time">
            Start time
          </label>
          <input
            class="input"
            id="event-start-time"
            name="startTime"
            type="time"
            aria-describedby="event-start-time-error"
          />
          <p class="field__error" id="event-start-time-error" data-error-for="startTime"></p>
        </div>
      </div>

      <div class="field-row">
        <div class="field">
          <label class="field__label" for="event-end-date">
            Ends
          </label>
          <input
            class="input"
            id="event-end-date"
            name="endDate"
            type="date"
            aria-describedby="event-end-date-error"
            required
          />
          <p class="field__error" id="event-end-date-error" data-error-for="endDate"></p>
        </div>
        <div class="field" data-time-field>
          <label class="field__label" for="event-end-time">
            End time (optional)
          </label>
          <input
            class="input"
            id="event-end-time"
            name="endTime"
            type="time"
            aria-describedby="event-end-time-error"
          />
          <p class="field__error" id="event-end-time-error" data-error-for="endTime"></p>
        </div>
      </div>

      <div class="field-row">
        <div class="field">
          <label class="field__label" for="event-repeat">
            Repeats
          </label>
          <select class="input" id="event-repeat" name="repeat">
            {REPEATS.map((repeat) => (
              <option value={repeat}>{REPEAT_LABELS[repeat]}</option>
            ))}
          </select>
        </div>
        <div class="field" data-until-field hidden>
          <label class="field__label" for="event-repeat-until">
            Until (optional)
          </label>
          <input
            class="input"
            id="event-repeat-until"
            name="repeatUntil"
            type="date"
            aria-describedby="event-repeat-until-error"
          />
          <p class="field__error" id="event-repeat-until-error" data-error-for="repeatUntil"></p>
        </div>
      </div>

      <div class="field">
        <label class="field__label" for="event-reminder">
          Reminder
        </label>
        <!-- Choices depend on "All day", so the script fills them in. -->
        <select
          class="input"
          id="event-reminder"
          name="reminder"
          aria-describedby="event-reminder-error"
        >
          <option value="">No reminder</option>
        </select>
        <p class="field__error" id="event-reminder-error" data-error-for="reminder"></p>
      </div>

      <div class="field">
        <label class="field__label" for="event-notes">
          Notes (optional)
        </label>
        <textarea
          dir="auto"
          class="input"
          id="event-notes"
          name="notes"
          maxlength={MAX_NOTES_LENGTH}
          aria-describedby="event-notes-error"
        ></textarea>
        <p class="field__error" id="event-notes-error" data-error-for="notes"></p>
      </div>

      <p class="field__error" role="alert" data-error-for="form"></p>

      <div class="cluster dialog__actions">
        <Button type="submit" variant="primary">
          Save
        </Button>
        <Button data-action="cancel">Cancel</Button>
        <Button variant="danger" icon="trash" data-action="delete" class="dialog__delete">
          Delete
        </Button>
      </div>
    </form>
  </dialog>

  <dialog class="dialog" aria-labelledby="delete-event-title" data-delete-dialog>
    <form method="dialog" class="stack">
      <h2 id="delete-event-title">Delete this event?</h2>
      <p data-delete-message>This event will be removed.</p>
      <div class="cluster">
        <Button type="submit" value="cancel">
          Cancel
        </Button>
        <Button type="submit" variant="danger" value="confirm">
          Delete
        </Button>
      </div>
    </form>
  </dialog>
  <!-- What the file has (or why it can't be used) is read out as it opens (audit G-9). -->
  <dialog
    class="dialog"
    aria-labelledby="import-title"
    aria-describedby="import-details"
    data-import-dialog
  >
    <form method="dialog" class="stack">
      <h2 id="import-title">Import events</h2>
      <div class="stack stack--sm" id="import-details" data-import-details></div>
      <div class="stack stack--sm" data-import-skipped-block hidden>
        <p>These can’t be imported:</p>
        <ul class="import-skipped" data-import-skipped></ul>
      </div>
      <div class="cluster">
        <Button type="submit" value="cancel" data-import-cancel>
          Cancel
        </Button>
        <Button type="submit" variant="primary" value="confirm" data-import-confirm>
          Import
        </Button>
      </div>
    </form>
  </dialog>
</AppShell>

<script>
  import { mountCalendar } from '../scripts/calendar.ts';

  mountCalendar(document);
</script>

<style>
  .calendar-layout {
    display: grid;
    gap: var(--space-6);
    align-items: start;
  }

  @media (min-width: 60rem) {
    .calendar-layout {
      grid-template-columns: minmax(0, 3fr) minmax(18rem, 2fr);
    }
  }

  .month__title {
    font-size: var(--text-xl);
  }

  .month__nav {
    --cluster-gap: var(--space-2);
  }

  .month__grid {
    width: 100%;
    table-layout: fixed;
    border-collapse: separate;
    border-spacing: 2px;
  }

  .month__grid :global(th) {
    padding-block: var(--space-1);
    font-size: var(--text-sm);
    font-weight: var(--weight-semibold);
    color: var(--color-text-muted);
    text-align: center;
  }

  /*
   * With large text, seven columns leave little room: weekdays are "M T W"
   * instead of "Mon Tue Wed" running together, and day numbers grow only as
   * big as their day (audit G-4). The month's width decides (cqi: 1% of it).
   */
  .month {
    container-type: inline-size;
  }

  .month__grid :global(.weekday__narrow) {
    display: none;
  }

  @container (max-width: 15rem) {
    .month__grid :global(.weekday__short) {
      display: none;
    }

    .month__grid :global(.weekday__narrow) {
      display: inline;
    }
  }

  .month__grid :global(.day-cell__number) {
    font-size: min(1em, 9cqi);
  }

  .month__grid :global(td) {
    padding: 0;
    vertical-align: top;
  }

  .month__grid :global(.day-cell) {
    position: relative;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: flex-start;
    gap: 2px;
    width: 100%;
    min-height: clamp(2.75rem, 9vw, 4.5rem);
    padding: var(--space-1) 0;
    border: var(--border-width) solid transparent;
    border-radius: var(--radius-sm);
    background: transparent;
    color: var(--color-text);
    font-variant-numeric: tabular-nums;
    cursor: pointer;
    touch-action: manipulation;
  }

  .month__grid :global(.day-cell:hover) {
    background: var(--color-surface-sunken);
  }

  .month__grid :global(.day-cell[aria-current='date']) {
    border-color: var(--color-accent);
    font-weight: var(--weight-bold);
  }

  .month__grid :global(.day-cell[aria-pressed='true']) {
    background: var(--color-accent);
    color: var(--color-on-accent);
  }

  .month__grid :global(.day-cell__dots) {
    display: flex;
    gap: 3px;
  }

  .month__grid :global(.day-cell__dot) {
    width: 6px;
    height: 6px;
    border-radius: var(--radius-full);
    background: currentColor;
  }

  /* A day off: the number underlined, in red (on the selected day, its colour). */
  .month__grid :global(.day-cell--off .day-cell__number),
  .legend__off {
    text-decoration: underline;
    text-decoration-thickness: 2px;
    text-underline-offset: 3px;
  }

  .month__grid :global(.day-cell--off:not([aria-pressed='true']) .day-cell__number),
  .legend__off {
    color: var(--color-danger);
  }

  /* An Orthodox holiday: a ring. */
  .month__grid :global(.day-cell__ring),
  .legend__ring {
    box-sizing: border-box;
    width: 7px;
    height: 7px;
    border: 1.5px solid currentColor;
    border-radius: var(--radius-full);
  }

  /* A fast: a line along the bottom, joining up across the days of a long fast. */
  .month__grid :global(.day-cell--fast::after),
  .legend__fast {
    height: 3px;
    border-radius: var(--radius-full);
    background: var(--color-text-muted);
  }

  .month__grid :global(.day-cell--fast::after) {
    content: '';
    position: absolute;
    inset-inline: 2px;
    bottom: 2px;
  }

  .month__grid :global(.day-cell--fast[aria-pressed='true']::after) {
    background: currentColor;
  }

  /* Windows contrast themes replace backgrounds, so the selected day, the dots
     and the fast line use the theme's own colours there (audit G-6). They
     also draw every day's border, so today's didn't stand out: only today's
     shows, twice as thick (audit 4 G-10). */
  @media (forced-colors: active) {
    .month__grid :global(.day-cell) {
      border-color: Canvas;
    }

    .month__grid :global(.day-cell[aria-current='date']) {
      border-color: CanvasText;
      outline: var(--border-width) solid CanvasText;
      outline-offset: calc(-2 * var(--border-width));
    }

    .month__grid :global(.day-cell[aria-pressed='true']) {
      forced-color-adjust: none;
      background: SelectedItem;
      color: SelectedItemText;
    }

    .month__grid :global(.day-cell__dot),
    .month__grid :global(.day-cell--fast::after),
    .legend__fast {
      forced-color-adjust: none;
      background: CanvasText;
    }

    .month__grid :global(.day-cell[aria-pressed='true'] .day-cell__dot),
    .month__grid :global(.day-cell--fast[aria-pressed='true']::after) {
      background: SelectedItemText;
    }
  }

  .month__legend {
    --cluster-gap: var(--space-1) var(--space-4);
    font-size: var(--text-sm);
  }

  .legend {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
  }

  .legend__off {
    font-weight: var(--weight-semibold);
    font-variant-numeric: tabular-nums;
  }

  .legend__ring {
    display: inline-block;
  }

  .legend__fast {
    display: inline-block;
    width: 1.25rem;
  }

  .month__hint {
    font-size: var(--text-sm);
  }

  @media (hover: none) {
    .month__hint {
      display: none;
    }
  }

  .event-list {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
  }

  .event-list:empty {
    display: none;
  }

  /* Time on top, title below, repeat icon at the end: fits at 320px wide. */
  .event-list :global(.event-item) {
    display: grid;
    grid-template-columns: 1fr auto;
    grid-template-areas:
      'when icons'
      'title icons';
    align-items: center;
    column-gap: var(--space-3);
    width: 100%;
    min-height: var(--tap-target);
    padding: var(--space-2) var(--space-3);
    border: var(--border-width) solid var(--color-border);
    border-left: 4px solid var(--color-accent);
    border-radius: var(--radius);
    background: var(--color-surface);
    color: var(--color-text);
    text-align: start;
    cursor: pointer;
  }

  .event-list :global(.event-item:hover) {
    border-color: var(--color-border-strong);
    border-left-color: var(--color-accent);
  }

  .event-list :global(.event-item__when) {
    grid-area: when;
    font-size: var(--text-sm);
    color: var(--color-text-muted);
    font-variant-numeric: tabular-nums;
  }

  .event-list :global(.event-item__title) {
    grid-area: title;
    font-weight: var(--weight-semibold);
    overflow-wrap: anywhere;
  }

  .event-list :global(.event-item__icons) {
    grid-area: icons;
    display: flex;
    gap: var(--space-1);
    color: var(--color-text-muted);
  }

  /* A holiday or fast: like an event, but it can't be opened or changed. */
  .event-list :global(.special-item) {
    display: flex;
    flex-direction: column;
    padding: var(--space-2) var(--space-3);
    border: var(--border-width) solid var(--color-border);
    border-left: 4px solid var(--color-border-strong);
    border-radius: var(--radius);
    background: var(--color-surface);
  }

  .event-list :global(.special-item--off) {
    border-left-color: var(--color-danger);
  }

  .event-list :global(.special-item--feast) {
    border-left-color: var(--color-accent);
  }

  .event-list :global(.special-item__kind),
  .event-list :global(.special-item__local) {
    font-size: var(--text-sm);
    color: var(--color-text-muted);
  }

  .event-list :global(.special-item__name) {
    font-weight: var(--weight-semibold);
    overflow-wrap: anywhere;
  }

  fieldset,
  legend {
    margin: 0;
    padding: 0;
    border: 0;
  }

  .special-weekly {
    padding-inline-start: var(--space-6);
  }

  .due__title {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    font-size: var(--text-lg);
  }

  .import-skipped {
    padding-inline-start: var(--space-5);
    overflow-wrap: anywhere;
  }

  .dialog__actions .dialog__delete {
    margin-inline-start: auto;
  }
</style>
