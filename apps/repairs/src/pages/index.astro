---
/**
 * Repairs: every repair, the latest day first, with search and a filter for
 * one vehicle; the vehicles; kilometres or miles, a spreadsheet download and
 * "Delete a year"; forms for a repair (with its parts) and a vehicle.
 * Behaviour: ../scripts/repairs.ts.
 */
import { AppShell, Button, DataControls, Icon, SyncControls } from '@shkriuss/ui';
import { CURRENCIES, LIMITS, UNIT_LABELS, UNITS } from '../lib/repairs.ts';
---

<AppShell>
  <div class="stack stack--lg">
    <header class="stack stack--sm">
      <h1>Repairs</h1>
      <p class="lead">
        A record of every repair, vehicle by vehicle. Your records are saved on this device.
      </p>
    </header>

    <!-- Once Repairs is nearly full: how much room is left, and how to make more. -->
    <p class="notice" data-room-note hidden></p>

    <div>
      <Button variant="primary" icon="plus" data-action="new-repair">
        New repair
      </Button>
    </div>

    <section class="stack" aria-labelledby="repairs-heading">
      <h2 id="repairs-heading" tabindex="-1" data-repairs-heading>
        Repair history
      </h2>
      <div class="field-row filters">
        <div class="field">
          <label class="field__label" for="search">
            Search
          </label>
          <input
            dir="auto"
            class="input"
            id="search"
            type="search"
            autocomplete="off"
            placeholder="Bus number, damage, part…"
            data-search
          />
        </div>
        <div class="field">
          <label class="field__label" for="vehicle-filter">
            Vehicle
          </label>
          <select class="input" id="vehicle-filter" data-vehicle-filter>
            <option value="">All vehicles</option>
          </select>
        </div>
      </div>
      <p class="muted" data-result-count hidden></p>
      <p class="muted" data-no-repairs>
        No repairs yet. Tap “New repair” to add your first.
      </p>
      <p class="muted" data-no-matches hidden>
        No repairs match your search.
      </p>
      <div class="stack" data-days></div>
      <div data-more hidden>
        <Button data-action="more">Show more</Button>
      </div>
    </section>

    <section class="stack" aria-labelledby="vehicles-heading">
      <h2 id="vehicles-heading">Vehicles</h2>
      <p class="muted" data-no-vehicles>
        No vehicles yet. A vehicle is added when you save its first repair, or add one here.
      </p>
      <ul role="list" class="vehicles" data-vehicles></ul>
      <div>
        <Button icon="plus" data-action="new-vehicle">
          Add vehicle
        </Button>
      </div>
    </section>

    <section class="stack" aria-labelledby="settings-heading">
      <h2 id="settings-heading">Units and spreadsheet</h2>
      <div class="field-row units">
        <div class="field">
          <label class="field__label" for="unit">
            Distance
          </label>
          <select class="input" id="unit" aria-describedby="unit-hint" data-unit>
            {UNITS.map((unit) => (
              <option value={unit}>{UNIT_LABELS[unit]}</option>
            ))}
          </select>
          <p class="field__hint" id="unit-hint">
            Shown with every mileage. Numbers aren’t converted.
          </p>
        </div>
        <div class="field">
          <label class="field__label" for="currency">
            Currency
          </label>
          <select class="input" id="currency" aria-describedby="currency-hint" data-currency>
            {CURRENCIES.map((currency) => (
              <option value={currency}>{currency}</option>
            ))}
          </select>
          <p class="field__hint" id="currency-hint">
            Shown with every cost. Amounts aren’t converted.
          </p>
        </div>
      </div>
      <div class="cluster">
        <Button icon="download" data-action="csv">
          Download as a spreadsheet (CSV)
        </Button>
        <Button icon="trash" aria-haspopup="dialog" data-action="delete-year">
          Delete a year…
        </Button>
      </div>
      <p class="muted" role="status" data-csv-status></p>
    </section>

    <SyncControls />

    <DataControls />
  </div>

  <!-- Live region: tells screen reader users what changed. -->
  <p class="visually-hidden" role="status" data-announcer></p>

  <!-- Suggestions for the forms, filled in by the script. -->
  <datalist id="vehicle-names" data-vehicle-names></datalist>
  <datalist id="system-names" data-system-names></datalist>
  <datalist id="part-names" data-part-names></datalist>
  <datalist id="model-names" data-model-names></datalist>

  <!-- One day of repairs, copied by the script for each. -->
  <template data-day-template>
    <div class="stack stack--sm">
      <div class="day__top">
        <h3 class="day__heading" data-day-heading>
          Day
        </h3>
        <span class="muted day__total" data-day-total></span>
      </div>
      <ul role="list" class="repairs" data-day-list></ul>
    </div>
  </template>

  <!-- One repair. -->
  <template data-repair-template>
    <li class="repair">
      <div class="repair__top">
        <button
          dir="auto"
          type="button"
          class="repair__title"
          aria-haspopup="dialog"
          data-action="edit-repair"
          data-title
        >
          Vehicle
        </button>
        <span class="muted repair__meta" data-meta></span>
      </div>
      <dl class="repair__details">
        <div data-row="problem">
          <dt>Damage found</dt>
          <dd dir="auto" data-problem></dd>
        </div>
        <div data-row="work">
          <dt>Work done</dt>
          <dd dir="auto" data-work></dd>
        </div>
        <div data-row="parts">
          <dt>Parts replaced</dt>
          <dd>
            <ul class="repair__parts" data-parts></ul>
          </dd>
        </div>
        <div data-row="photos">
          <dt>Photos</dt>
          <dd class="stack stack--sm">
            <ul role="list" class="photos" data-photos></ul>
            <p class="muted photos__elsewhere" data-photos-elsewhere></p>
          </dd>
        </div>
        <div data-row="hours">
          <dt>Hours worked</dt>
          <dd data-hours></dd>
        </div>
        <div data-row="cost">
          <dt>Cost</dt>
          <dd data-cost></dd>
        </div>
      </dl>
    </li>
  </template>

  <!-- One vehicle. -->
  <template data-vehicle-template>
    <li class="vehicle">
      <div class="vehicle__text">
        <span dir="auto" class="vehicle__name" data-name>
          Vehicle
        </span>
        <span dir="auto" class="muted" data-details></span>
        <span class="muted" data-summary></span>
      </div>
      <div class="cluster vehicle__actions">
        <Button data-action="show-vehicle">
          <span>
            Show repairs<span class="visually-hidden" data-hidden-name></span>
          </span>
        </Button>
        <Button icon="pencil" data-action="edit-vehicle">
          <span>
            Edit<span class="visually-hidden" data-hidden-name></span>
          </span>
        </Button>
      </div>
    </li>
  </template>

  <!-- One part in the repair form. -->
  <template data-part-template>
    <li class="part-row">
      <fieldset class="stack stack--sm">
        <legend class="field__label" data-legend>
          Part
        </legend>
        <div class="field">
          <label class="field">
            <span class="field__label">Name</span>
            <input
              dir="auto"
              class="input"
              type="text"
              list="part-names"
              autocomplete="off"
              maxlength={LIMITS.partName}
              placeholder="e.g. Brake pads"
              data-part="name"
            />
          </label>
          <p class="field__error" data-error="name"></p>
        </div>
        <div class="field-row">
          <div class="field">
            <label class="field">
              <span class="field__label">Part number (optional)</span>
              <input
                dir="auto"
                class="input"
                type="text"
                autocomplete="off"
                maxlength={LIMITS.partNumber}
                data-part="number"
              />
            </label>
            <p class="field__error" data-error="number"></p>
          </div>
          <div class="field">
            <label class="field">
              <span class="field__label">Quantity</span>
              <input
                class="input"
                type="text"
                inputmode="decimal"
                autocomplete="off"
                data-part="quantity"
              />
            </label>
            <p class="field__error" data-error="quantity"></p>
          </div>
          <div class="field">
            <label class="field">
              <span class="field__label">Price each (optional)</span>
              <input
                class="input"
                type="text"
                inputmode="decimal"
                autocomplete="off"
                data-part="price"
              />
            </label>
            <p class="field__error" data-error="price"></p>
          </div>
        </div>
        <div>
          <Button variant="ghost" icon="x" data-action="remove-part">
            <span>
              Remove<span class="visually-hidden" data-hidden-part></span>
            </span>
          </Button>
        </div>
      </fieldset>
    </li>
  </template>

  <!-- One photo of a repair: opens it. -->
  <template data-thumb-template>
    <li>
      <button type="button" class="photo" aria-haspopup="dialog" data-action="view-photo">
        <img class="photo__image" alt="" data-thumb />
      </button>
    </li>
  </template>

  <!-- One photo in the repair form. -->
  <template data-form-photo-template>
    <li class="form-photo">
      <img class="form-photo__image" alt="" data-thumb />
      <Button variant="ghost" icon="x" label="Remove photo" data-action="remove-photo" />
    </li>
  </template>

  <dialog class="dialog" aria-labelledby="repair-title" data-repair-dialog>
    <form class="stack" data-repair-form novalidate>
      <h2 id="repair-title" data-repair-title>
        New repair
      </h2>
      <div class="field-row">
        <div class="field">
          <label class="field__label" for="repair-vehicle">
            Vehicle
          </label>
          <input
            dir="auto"
            class="input"
            id="repair-vehicle"
            name="vehicle"
            type="text"
            list="vehicle-names"
            autocomplete="off"
            maxlength={LIMITS.vehicle}
            placeholder="e.g. Bus 105"
            aria-describedby="repair-vehicle-hint repair-vehicle-error"
            required
          />
          <p class="field__hint" id="repair-vehicle-hint">
            A bus number, plate or name. A new one is added to your vehicles.
          </p>
          <p class="field__error" id="repair-vehicle-error" data-error-for="vehicle"></p>
        </div>
        <div class="field">
          <label class="field__label" for="repair-date">
            Day
          </label>
          <input
            class="input"
            id="repair-date"
            name="date"
            type="date"
            aria-describedby="repair-date-error"
            required
          />
          <p class="field__error" id="repair-date-error" data-error-for="date"></p>
        </div>
      </div>
      <div class="field-row">
        <div class="field">
          <label class="field__label" for="repair-mileage" data-mileage-label>
            Mileage (km)
          </label>
          <!-- Text, not type="number": that would read "120.000" as 120 (audit F2-1). -->
          <input
            class="input"
            id="repair-mileage"
            name="mileage"
            type="text"
            inputmode="numeric"
            autocomplete="off"
            aria-describedby="repair-mileage-hint repair-mileage-error"
          />
          <p class="field__hint" id="repair-mileage-hint" data-mileage-hint></p>
          <p class="field__error" id="repair-mileage-error" data-error-for="mileage"></p>
        </div>
        <div class="field">
          <label class="field__label" for="repair-system">
            System (optional)
          </label>
          <input
            dir="auto"
            class="input"
            id="repair-system"
            name="system"
            type="text"
            list="system-names"
            autocomplete="off"
            maxlength={LIMITS.system}
            placeholder="e.g. Brakes"
            aria-describedby="repair-system-error"
          />
          <p class="field__error" id="repair-system-error" data-error-for="system"></p>
        </div>
      </div>
      <div class="field">
        <label class="field__label" for="repair-problem">
          Damage found
        </label>
        <textarea
          dir="auto"
          class="input"
          id="repair-problem"
          name="problem"
          rows="3"
          maxlength={LIMITS.text}
          placeholder="What was wrong"
          aria-describedby="repair-problem-error"
        ></textarea>
        <p class="field__error" id="repair-problem-error" data-error-for="problem"></p>
      </div>
      <div class="field">
        <label class="field__label" for="repair-work">
          Work done
        </label>
        <textarea
          dir="auto"
          class="input"
          id="repair-work"
          name="work"
          rows="3"
          maxlength={LIMITS.text}
          placeholder="What you repaired, adjusted or checked"
          aria-describedby="repair-work-error"
        ></textarea>
        <p class="field__error" id="repair-work-error" data-error-for="work"></p>
      </div>
      <fieldset class="stack stack--sm parts">
        <legend class="field__label">Parts replaced</legend>
        <ol role="list" class="stack stack--sm part-rows" data-part-rows></ol>
        <p class="field__error" data-error-for="parts"></p>
        <div>
          <Button icon="plus" data-action="add-part">
            Add a part
          </Button>
        </div>
      </fieldset>
      <fieldset class="stack stack--sm">
        <legend class="field__label">Photos</legend>
        <ul role="list" class="photos" data-form-photos></ul>
        <p class="field__hint" data-form-photos-elsewhere hidden></p>
        <p class="field__hint" data-photos-sync-hint>
          Kept on this device, and not in backups. Turn on sync to have them on your other devices
          too.
        </p>
        <p class="field__hint" data-photos-busy hidden>
          Adding photos…
        </p>
        <!-- Read out when it's shown: focus is elsewhere then (on "Add photos"). -->
        <p class="field__error" role="alert" data-error-for="photos"></p>
        <input type="file" accept="image/*" multiple hidden data-photo-input />
        <div>
          <Button icon="camera" data-action="add-photos">
            Add photos
          </Button>
        </div>
      </fieldset>
      <div class="field-row">
        <div class="field">
          <label class="field__label" for="repair-hours">
            Hours worked (optional)
          </label>
          <input
            class="input"
            id="repair-hours"
            name="hours"
            type="text"
            inputmode="decimal"
            autocomplete="off"
            placeholder="e.g. 1.5"
            aria-describedby="repair-hours-error"
          />
          <p class="field__error" id="repair-hours-error" data-error-for="hours"></p>
        </div>
        <div class="field">
          <label class="field__label" for="repair-labour">
            Labour and other costs (optional)
          </label>
          <input
            class="input"
            id="repair-labour"
            name="labour"
            type="text"
            inputmode="decimal"
            autocomplete="off"
            aria-describedby="repair-labour-hint repair-labour-error"
          />
          <p class="field__hint" id="repair-labour-hint" data-labour-hint>
            In USD. Each part’s price goes with the part.
          </p>
          <p class="field__error" id="repair-labour-error" data-error-for="labour"></p>
        </div>
      </div>
      <div class="cluster dialog__actions">
        <Button type="submit" variant="primary">
          Save
        </Button>
        <Button data-action="cancel">Cancel</Button>
        <Button variant="danger" icon="trash" data-action="delete-repair" class="dialog__delete">
          Delete
        </Button>
      </div>
    </form>
  </dialog>

  <dialog class="dialog" aria-labelledby="vehicle-title" data-vehicle-dialog>
    <form class="stack" data-vehicle-form novalidate>
      <h2 id="vehicle-title" data-vehicle-title>
        Add vehicle
      </h2>
      <div class="field">
        <label class="field__label" for="vehicle-name">
          Name or number
        </label>
        <input
          dir="auto"
          class="input"
          id="vehicle-name"
          name="name"
          type="text"
          autocomplete="off"
          maxlength={LIMITS.vehicle}
          placeholder="e.g. Bus 105"
          aria-describedby="vehicle-name-error"
          required
        />
        <p class="field__error" id="vehicle-name-error" data-error-for="name"></p>
      </div>
      <div class="field">
        <label class="field__label" for="vehicle-model">
          Model (optional)
        </label>
        <input
          dir="auto"
          class="input"
          id="vehicle-model"
          name="model"
          type="text"
          list="model-names"
          autocomplete="off"
          maxlength={LIMITS.model}
          aria-describedby="vehicle-model-error"
        />
        <p class="field__error" id="vehicle-model-error" data-error-for="model"></p>
      </div>
      <div class="field">
        <label class="field__label" for="vehicle-plate">
          Number plate (optional)
        </label>
        <input
          dir="auto"
          class="input"
          id="vehicle-plate"
          name="plate"
          type="text"
          autocomplete="off"
          maxlength={LIMITS.plate}
          aria-describedby="vehicle-plate-error"
        />
        <p class="field__error" id="vehicle-plate-error" data-error-for="plate"></p>
      </div>
      <div class="field">
        <label class="field__label" for="vehicle-notes">
          Notes (optional)
        </label>
        <textarea
          dir="auto"
          class="input"
          id="vehicle-notes"
          name="notes"
          rows="3"
          maxlength={LIMITS.notes}
          aria-describedby="vehicle-notes-error"
        ></textarea>
        <p class="field__error" id="vehicle-notes-error" data-error-for="notes"></p>
      </div>
      <div class="cluster dialog__actions">
        <Button type="submit" variant="primary">
          Save
        </Button>
        <Button data-action="cancel">Cancel</Button>
        <Button variant="danger" icon="trash" data-action="delete-vehicle" class="dialog__delete">
          Delete
        </Button>
      </div>
    </form>
  </dialog>

  <dialog class="dialog photo-viewer" aria-labelledby="photo-title" data-photo-dialog>
    <div class="stack">
      <h2 id="photo-title" tabindex="-1" data-photo-title>
        Photo
      </h2>
      <!-- Says which photo Next or Previous showed (focus stays on the button). -->
      <p class="visually-hidden" role="status" data-photo-said></p>
      <img class="photo-viewer__image" alt="" data-photo-image />
      <div class="cluster">
        <Button icon="chevron-left" data-action="previous-photo">
          Previous
        </Button>
        <Button data-action="next-photo">
          <span>Next</span>
          <Icon name="chevron-right" />
        </Button>
        <Button icon="download" data-action="save-photo">
          Save a copy
        </Button>
        <Button data-action="cancel">Close</Button>
      </div>
    </div>
  </dialog>

  <dialog class="dialog" aria-labelledby="delete-title" data-delete-dialog>
    <form method="dialog" class="stack">
      <h2 id="delete-title" data-delete-title>
        Delete this?
      </h2>
      <p data-delete-text></p>
      <div class="cluster">
        <Button type="submit" value="cancel">
          Cancel
        </Button>
        <Button type="submit" variant="danger" value="confirm">
          Delete
        </Button>
      </div>
    </form>
  </dialog>

  <!-- "Delete a year…": every repair of the year chosen, with its photos, to make room. -->
  <dialog class="dialog" aria-labelledby="year-title" data-year-dialog>
    <form class="stack" data-year-form novalidate>
      <h2 id="year-title">Delete a year</h2>
      <div class="field">
        <label class="field__label" for="year-select">
          Year
        </label>
        <select
          class="input"
          id="year-select"
          aria-describedby="year-text"
          data-year-select
        ></select>
      </div>
      <p id="year-text" aria-live="polite" data-year-text></p>
      <p class="muted">
        To keep a copy of them, download the spreadsheet first: it has every repair (photos aren’t
        in it).
      </p>
      <div>
        <Button icon="download" data-action="csv">
          Download as a spreadsheet (CSV)
        </Button>
      </div>
      <p class="muted" role="status" data-csv-status></p>
      <div class="cluster">
        <Button data-action="cancel">Cancel</Button>
        <Button type="submit" variant="danger" icon="trash">
          <span data-year-confirm>Delete</span>
        </Button>
      </div>
    </form>
  </dialog>
</AppShell>

<script>
  import { mountRepairs } from '../scripts/repairs.ts';

  mountRepairs(document);
</script>

<style>
  .filters {
    max-inline-size: 36rem;
  }

  .day__top {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: 0 var(--space-3);
  }

  .day__heading {
    font-size: var(--text-base);
    color: var(--color-text-muted);
  }

  .day__total {
    font-size: var(--text-sm);
  }

  .day__total:empty {
    display: none;
  }

  .repairs,
  .vehicles {
    display: grid;
    gap: var(--space-2);
  }

  .repair,
  .vehicle {
    display: grid;
    gap: var(--space-1);
    padding: var(--space-2) var(--space-3);
    border: var(--border-width) solid var(--color-border);
    border-radius: var(--radius);
    background: var(--color-surface);
  }

  .repair__top {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 0 var(--space-3);
  }

  /*
   * The vehicle opens the repair: it reads as text, works as a button. It
   * fills its line, beside the mileage, so vehicle "7" is still a big
   * target (audit 3 G-9).
   */
  .repair__title {
    flex: 1 1 auto;
    min-width: var(--tap-target);
    min-height: var(--tap-target);
    padding: 0;
    border: 0;
    background: none;
    color: inherit;
    font: inherit;
    font-weight: var(--weight-bold);
    text-align: start;
    overflow-wrap: anywhere;
    cursor: pointer;
  }

  .repair__title:hover {
    color: var(--color-accent);
  }

  .repair__meta {
    font-size: var(--text-sm);
  }

  .repair__details {
    display: grid;
    gap: var(--space-2);
    margin: 0;
    padding-block-end: var(--space-1);
  }

  .repair__details dt {
    font-size: var(--text-sm);
    font-weight: var(--weight-semibold);
    color: var(--color-text-muted);
  }

  .repair__details dd {
    margin: 0;
    white-space: pre-line;
    overflow-wrap: anywhere;
  }

  .repair__parts {
    margin: 0;
    padding-inline-start: var(--space-5);
  }

  .vehicle {
    gap: var(--space-2);
  }

  .vehicle__text {
    display: grid;
    gap: var(--space-1);
    overflow-wrap: anywhere;
  }

  .vehicle__text .muted {
    font-size: var(--text-sm);
  }

  .vehicle__text .muted:empty {
    display: none;
  }

  .vehicle__name {
    font-weight: var(--weight-bold);
  }

  .vehicle__actions {
    --cluster-gap: var(--space-2);
  }

  .units {
    max-inline-size: 32rem;
  }

  fieldset {
    min-width: 0;
    margin: 0;
    padding: 0;
    border: 0;
  }

  .part-row {
    padding: var(--space-3);
    border: var(--border-width) solid var(--color-border);
    border-radius: var(--radius);
  }

  .part-rows:empty {
    display: none;
  }

  .dialog__actions .dialog__delete {
    margin-inline-start: auto;
  }

