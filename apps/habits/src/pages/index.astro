---
/**
 * Habits: today's habits with a "Done today" button, streaks and the last 7
 * days, plus an edit dialog (name, days, reminder, the last two weeks,
 * delete) and "Delete check marks from a year…". Behaviour:
 * ../scripts/habits.ts and ../scripts/reminders.ts.
 */
import { AppShell, Button, DataControls, Icon, PushControls, SyncControls } from '@shkriuss/ui';
import { EDITABLE_DAYS, MAX_CHECKS, MAX_NAME_LENGTH } from '../lib/habits.ts';
---

<AppShell wide>
  <div class="stack stack--lg">
    <header class="stack stack--sm">
      <h1>Habits</h1>
      <p class="lead">Build habits one day at a time. Your progress is saved on this device.</p>
    </header>

    <!-- Once Habits is nearly full: how much room is left, and how to make more. -->
    <p class="notice" data-room-note hidden></p>

    <form class="add-form" data-add-form novalidate>
      <div class="field add-form__field">
        <label class="field__label" for="habit-name">
          New habit
        </label>
        <input
          dir="auto"
          class="input"
          id="habit-name"
          name="name"
          type="text"
          autocomplete="off"
          enterkeyhint="done"
          maxlength={MAX_NAME_LENGTH}
          placeholder="e.g. Drink water"
          aria-describedby="habit-name-error"
          required
        />
        <p class="field__error" id="habit-name-error" data-error-for="name"></p>
      </div>
      <Button type="submit" variant="primary" icon="plus" class="add-form__submit">
        Add
      </Button>
    </form>

    <section class="stack" aria-labelledby="today-heading">
      <div class="stack stack--sm">
        <h2 id="today-heading">Today</h2>
        <p class="muted" data-today></p>
      </div>
      <p class="muted" data-empty>
        No habits yet. Add one above, like “Drink water” or “Read 10 pages”.
      </p>
      <ul role="list" class="grid habits" data-habits></ul>
    </section>

    <section class="stack" aria-labelledby="reminders-heading">
      <h2 id="reminders-heading">Reminders</h2>
      <p class="muted">
        To get reminded, open a habit with its pencil button and turn on “Remind me”. Reminders come
        on the days it’s planned for, unless it’s already done.
      </p>
      <p class="muted">
        With sync on, your reminders are the same on all your devices. Each device reminds you once
        notifications are turned on there.
      </p>
      <p data-notify-status>Notifications are off.</p>
      <p data-notify-enable hidden>
        <Button icon="bell" data-action="enable-notifications">
          Turn on notifications
        </Button>
      </p>
      <PushControls />
    </section>

    <section class="stack" aria-labelledby="checks-heading">
      <h2 id="checks-heading">Check marks</h2>
      <p class="muted">
        Habits keeps up to {new Intl.NumberFormat('en-US').format(MAX_CHECKS)} check marks: enough
        for 10 habits ticked every day for over 2½ years. To make room, delete the ones from a year
        you no longer need.
      </p>
      <div>
        <Button icon="trash" aria-haspopup="dialog" data-action="delete-year">
          Delete check marks from a year…
        </Button>
      </div>
      <p class="muted" role="status" data-year-status></p>
    </section>

    <SyncControls />

    <DataControls />
  </div>

  <!-- Live region: tells screen reader users what changed. -->
  <p class="visually-hidden" role="status" data-announcer></p>

  <!-- Markup for one habit, copied by the script for each habit. -->
  <template data-habit-template>
    <li class="card habit">
      <div class="habit__header">
        <div class="stack stack--sm">
          <h3 dir="auto" class="habit__name" data-name>
            Habit
          </h3>
          <p class="muted habit__schedule" data-schedule></p>
          <p class="muted habit__schedule habit__reminder" data-reminder hidden>
            <Icon name="bell" />
            <span data-reminder-time>Reminder</span>
          </p>
        </div>
        <button type="button" class="btn btn--ghost btn--icon" data-action="edit">
          <Icon name="pencil" />
        </button>
      </div>
      <button type="button" class="btn btn--lg habit__done" aria-pressed="false" data-action="done">
        <Icon name="check" />
        Done today
      </button>
      <p class="muted" data-not-planned hidden>
        Not planned for today, but you can still tick it.
      </p>
      <p class="habit__streak" data-streak></p>
      <div class="habit__week" aria-hidden="true" data-week></div>
      <p class="visually-hidden" data-week-summary></p>
    </li>
  </template>

  <!-- One day in a habit's last 7 days (for the eye; the summary above is read out). -->
  <template data-day-template>
    <span class="day">
      <span class="day__name" data-day-name></span>
      <span class="day__mark" data-day-mark>
        <Icon name="check" />
      </span>
    </span>
  </template>

  <template data-check-template>
    <label class="check">
      <input type="checkbox" />
      <span data-check-label>Day</span>
    </label>
  </template>

  <dialog class="dialog" aria-labelledby="edit-title" data-edit-dialog>
    <form class="stack" data-edit-form novalidate>
      <h2 id="edit-title">Edit habit</h2>
      <div class="field">
        <label class="field__label" for="edit-name">
          Name
        </label>
        <input
          dir="auto"
          class="input"
          id="edit-name"
          name="name"
          type="text"
          autocomplete="off"
          maxlength={MAX_NAME_LENGTH}
          aria-describedby="edit-name-error"
          required
        />
        <p class="field__error" id="edit-name-error" data-error-for="name"></p>
      </div>
      <fieldset class="stack stack--sm" aria-describedby="edit-days-error">
        <legend class="field__label">Planned days</legend>
        <div class="cluster day-checks" data-day-checks></div>
        <p class="field__error" id="edit-days-error" data-error-for="days"></p>
      </fieldset>
      <div class="stack stack--sm">
        <label class="check">
          <input type="checkbox" name="remind" />
          <span>Remind me</span>
        </label>
        <div class="field" data-reminder-field hidden>
          <label class="field__label" for="edit-reminder">
            Reminder time
          </label>
          <input
            class="input reminder-time"
            id="edit-reminder"
            name="reminder"
            type="time"
            aria-describedby="edit-reminder-hint edit-reminder-error"
            required
          />
          <p class="field__hint" id="edit-reminder-hint">
            On planned days, if it isn’t done yet.
          </p>
          <p class="field__error" id="edit-reminder-error" data-error-for="reminder"></p>
        </div>
      </div>
      <fieldset class="stack stack--sm" aria-describedby="edit-done-hint edit-done-error">
        <legend class="field__label">Done on</legend>
        <p class="field__hint" id="edit-done-hint">
          Forgot to tick a day? Fix the last {EDITABLE_DAYS / 7} weeks here.
        </p>
        <div class="past-days" data-past-days></div>
        <p class="field__error" id="edit-done-error" data-error-for="past"></p>
      </fieldset>
      <div class="cluster dialog__actions">
        <Button type="submit" variant="primary">
          Save
        </Button>
        <Button data-action="cancel">Cancel</Button>
        <Button variant="danger" icon="trash" data-action="delete" class="dialog__delete">
          Delete
        </Button>
      </div>
    </form>
  </dialog>

  <!-- "Delete check marks from a year…": every habit's, from the year chosen, to make room. -->
  <dialog class="dialog" aria-labelledby="year-title" data-year-dialog>
    <form class="stack" data-year-form novalidate>
      <h2 id="year-title">Delete check marks from a year</h2>
      <div class="field">
        <label class="field__label" for="year-select">
          Year
        </label>
        <select
          class="input"
          id="year-select"
          aria-describedby="year-text"
          data-year-select
        ></select>
      </div>
      <p id="year-text" aria-live="polite" data-year-text></p>
      <div class="cluster">
        <Button data-action="cancel">Cancel</Button>
        <Button type="submit" variant="danger" icon="trash">
          <span data-year-confirm>Delete</span>
        </Button>
      </div>
    </form>
  </dialog>

  <!-- Read out with its title: what goes, and that it can't be undone (audit 5 G-3). -->
  <dialog
    class="dialog"
    aria-labelledby="delete-title"
    aria-describedby="delete-message"
    data-delete-dialog
  >
    <form method="dialog" class="stack">
      <h2 id="delete-title">Delete this habit?</h2>
      <p id="delete-message">
        “<span dir="auto" data-delete-name></span>” and all its check marks will be removed. This
        can’t be undone.
      </p>
      <div class="cluster">
        <Button type="submit" value="cancel">
          Cancel
        </Button>
        <Button type="submit" variant="danger" value="confirm">
          Delete
        </Button>
      </div>
    </form>
  </dialog>
</AppShell>

<script>
  import { mountHabits } from '../scripts/habits.ts';

  mountHabits(document);
</script>

<style>
  .add-form {
    display: flex;
    flex-wrap: wrap;
    align-items: start;
    gap: var(--space-3);
  }

  .add-form__field {
    flex: 1 1 16rem;
  }

  /* Line the button up with the input (label height + small gap). */
  .add-form__submit {
    margin-block-start: calc(var(--text-base) * var(--leading-normal) + var(--space-1));
  }

  .habits {
    --grid-min: 17rem;
  }

  .habit {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
  }

  .habit__header {
    display: flex;
    align-items: start;
    justify-content: space-between;
    gap: var(--space-2);
  }

  .habit__name {
    font-size: var(--text-lg);
    overflow-wrap: anywhere;
  }

  .habit__schedule {
    font-size: var(--text-sm);
  }

  .habit__done {
    width: 100%;
  }

  .habit__reminder {
    display: flex;
    align-items: center;
    gap: var(--space-1);
  }

  .habit__reminder :global(svg) {
    width: 1em;
    height: 1em;
  }

  .reminder-time {
    max-inline-size: 12rem;
  }

  .habit__streak {
    font-weight: var(--weight-semibold);
  }

  /* The last 7 days: a filled circle when done, a ring when planned, a dot when not.
     With large text, the circles get smaller to fit, not the page wider (audit G-4). */
  .habit__week {
    display: grid;
    grid-template-columns: repeat(7, minmax(0, 1fr));
    gap: var(--space-1);
    text-align: center;
  }

  .day {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-1);
    font-size: var(--text-xs);
    color: var(--color-text-muted);
  }

  .day--today {
    color: var(--color-text);
    font-weight: var(--weight-semibold);
  }

  .day__mark {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: min(1.75rem, 100%);
    aspect-ratio: 1;
    border: 2px solid var(--color-border-strong);
    border-radius: var(--radius-full);
  }

  .day__mark :global(svg) {
    width: min(1rem, 60%);
    height: auto;
    aspect-ratio: 1;
    visibility: hidden;
  }

  .day--done .day__mark {
    border-color: var(--color-accent);
    background: var(--color-accent);
    color: var(--color-on-accent);
  }

  .day--done .day__mark :global(svg) {
    visibility: visible;
  }

  .day--off .day__mark {
    border-style: dotted;
  }

  .day-checks {
    --cluster-gap: var(--space-1) var(--space-4);
  }

  .past-days {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 12rem), 1fr));
    column-gap: var(--space-4);
  }

  /* min-width: browsers make a fieldset as wide as its content otherwise (audit G-4). */
  fieldset {
    min-width: 0;
    margin: 0;
    padding: 0;
    border: 0;
  }

  .dialog__actions .dialog__delete {
    margin-inline-start: auto;
  }
</style>
