// Cloudflare Worker for this app: the static site, plus /api/push/* for
// reminders while Habits is closed (docs/adr/0009-push-notifications.md) and
// /api/sync/* for syncing between devices (docs/adr/0010-account-and-sync.md).
// Docs: docs/deployment.md
{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "habits",
  "compatibility_date": "2026-10-01",
  "main": "src/worker.ts",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    // Only /api/* runs the Worker code; every other request is a static file.
    "run_worker_first": ["/api/*"],
    "not_found_handling": "404-page",
    "html_handling": "auto-trailing-slash",
  },
  // One store per device (its scheduled reminders), one for the app's
  // signing keys, and one per synced account (its sealed copy of Habits'
  // data). SQLite-backed, as the free plan requires.
  "durable_objects": {
    "bindings": [
      { "name": "PUSH_DEVICES", "class_name": "PushDevice" },
      { "name": "PUSH_KEYS", "class_name": "PushKeys" },
      { "name": "SYNC_COPIES", "class_name": "SyncCopy" },
    ],
  },
  // In the order they were added (sync came first here).
  "migrations": [
    { "tag": "sync-v1", "new_sqlite_classes": ["SyncCopy"] },
    { "tag": "push-v1", "new_sqlite_classes": ["PushDevice", "PushKeys"] },
  ],
  // The real address. Cloudflare creates the DNS record and certificate.
  "routes": [{ "pattern": "habits.shkriuss.app", "custom_domain": true }],
  // Only at the real address: no *.workers.dev address, and no addresses for
  // single versions either (docs/adr/0019-no-pull-request-previews.md).
  // No Workers logs or traces: nothing about requests is kept (see the privacy page).
  "observability": { "enabled": false },
  "workers_dev": false,
  "preview_urls": false,
}
