{
  "name": "grammar",
  "version": "0.0.0",
  "private": true,
  "description": "The grammar app at grammar.shkriuss.app.",
  "type": "module",
  "scripts": {
    "dev": "node scripts/deep-check-files.ts && astro dev",
    "build": "node scripts/deep-check-files.ts && astro build",
    "preview": "wrangler dev --port 8787",
    "typecheck": "astro check",
    "deploy:production": "wrangler deploy",
    "deploy:preview": "wrangler preview",
    "deep-check-files": "node scripts/deep-check-files.ts",
    "on-demand-into-dist": "node scripts/deep-check-files.ts dist/on-demand/deep-check/"
  },
  "dependencies": {
    "@shkriuss/astro-config": "workspace:*",
    "@shkriuss/registry": "workspace:*",
    "@shkriuss/storage": "workspace:*",
    "@shkriuss/ui": "workspace:*",
    "astro": "catalog:",
    "harper.js": "catalog:",
    "onnxruntime-web": "catalog:"
  },
  "devDependencies": {
    "@astrojs/check": "catalog:",
    "typescript": "catalog:"
  }
}
