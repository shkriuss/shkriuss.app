// Cloudflare Worker for this app: the static site, plus /api/sync/* (syncing
// with the optional account, docs/adr/0010-account-and-sync.md) and
// /api/library/* (the online photo library, docs/adr/0016-online-photo-library.md).
// Docs: docs/deployment.md
{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "photos",
  "compatibility_date": "2026-10-01",
  "main": "src/worker.ts",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    // Only /api/* runs the Worker code; every other request is a static file.
    "run_worker_first": ["/api/*"],
    "not_found_handling": "404-page",
    "html_handling": "auto-trailing-slash",
  },
  // One store per account for the synced copy, one per library for its list
  // of photos, and one for the limits across all libraries. SQLite-backed, as
  // the free plan requires.
  "durable_objects": {
    "bindings": [
      { "name": "SYNC_COPIES", "class_name": "SyncCopy" },
      { "name": "LIBRARIES", "class_name": "Library" },
      { "name": "LIBRARY_GATE", "class_name": "LibraryGate" },
    ],
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["SyncCopy", "Library"] },
    { "tag": "v2", "new_sqlite_classes": ["LibraryGate"] },
  ],
  // The photos themselves, sealed on the device. CI creates the bucket, and
  // gives the Worker the storage code (LIBRARY_STORAGE_CODE) as a secret.
  "r2_buckets": [{ "binding": "LIBRARY_FILES", "bucket_name": "shkriuss-photos" }],
  // The real address. Cloudflare creates the DNS record and certificate.
  "routes": [{ "pattern": "photos.shkriuss.app", "custom_domain": true }],
  // Only at the real address: no *.workers.dev address, and no addresses for
  // single versions either (docs/adr/0019-no-pull-request-previews.md).
  // No Workers logs or traces: nothing about requests is kept (see the privacy page).
  "observability": { "enabled": false },
  "workers_dev": false,
  "preview_urls": false,
}
