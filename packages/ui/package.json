{
  "name": "@shkriuss/ui",
  "version": "0.0.0",
  "private": true,
  "description": "The shkriuss.app design system: tokens, styles, components, layouts and icons.",
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./env": {
      "types": "./src/env.d.ts"
    },
    "./busy": "./src/scripts/busy.ts",
    "./icons": "./src/icons/index.ts",
    "./colors": "./src/icons/colors.ts",
    "./dom": "./src/scripts/dom.ts",
    "./styles.css": "./src/styles/index.css",
    "./tokens.css": "./src/styles/tokens.css",
    "./components/*": "./src/components/*",
    "./layouts/*": "./src/layouts/*",
    "./locale": "./src/lib/locale.ts",
    "./local-reminders": "./src/scripts/local-reminders.ts",
    "./long-lists": "./src/lib/long-lists.ts",
    "./push-controls": "./src/scripts/push-controls.ts",
    "./numbers": "./src/lib/numbers.ts",
    "./problem": "./src/scripts/problem.ts",
    "./text": "./src/lib/text.ts",
    "./typed-text": "./src/scripts/typed-text.ts",
    "./qr-code": "./src/scripts/qr-code.ts",
    "./service-worker": "./src/scripts/service-worker.ts",
    "./sync-controls": "./src/scripts/sync-controls.ts",
    "./worker": "./src/scripts/worker.ts"
  },
  "scripts": {
    "typecheck": "astro check --noSync"
  },
  "dependencies": {
    "@shkriuss/dates": "workspace:*",
    "@shkriuss/push": "workspace:*",
    "@shkriuss/registry": "workspace:*",
    "@shkriuss/storage": "workspace:*",
    "@shkriuss/sync": "workspace:*"
  },
  "devDependencies": {
    "@astrojs/check": "catalog:",
    "astro": "catalog:",
    "typescript": "catalog:"
  },
  "peerDependencies": {
    "astro": "^7.0.0"
  }
}
