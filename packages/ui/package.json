{
  "name": "@shkriuss/ui",
  "version": "0.0.0",
  "private": true,
  "description": "The shkriuss.app design system: tokens, styles, components, layouts and icons.",
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./env": {
      "types": "./src/env.d.ts"
    },
    "./icons": "./src/icons/index.ts",
    "./colors": "./src/icons/colors.ts",
    "./styles.css": "./src/styles/index.css",
    "./tokens.css": "./src/styles/tokens.css",
    "./components/*": "./src/components/*",
    "./layouts/*": "./src/layouts/*",
    "./qr-code": "./src/scripts/qr-code.ts"
  },
  "scripts": {
    "typecheck": "astro check --noSync"
  },
  "dependencies": {
    "@shkriuss/push": "workspace:*",
    "@shkriuss/registry": "workspace:*",
    "@shkriuss/storage": "workspace:*"
  },
  "devDependencies": {
    "@astrojs/check": "catalog:",
    "astro": "catalog:",
    "typescript": "catalog:"
  },
  "peerDependencies": {
    "astro": "^7.0.0"
  }
}
