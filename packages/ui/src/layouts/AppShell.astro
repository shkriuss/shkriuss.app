---
/**
 * The page shell every page of every site uses: <head> tags, skip link,
 * header (with a note on previews of a change), main content, footer with the
 * theme switch, and offline support.
 *
 *   <AppShell title="Privacy">…page content…</AppShell>
 *
 * Site details (name, icon, colour) come from the registry entry of the
 * current site, provided by @shkriuss/astro-config.
 */
import '../styles/index.css';
import { hubOrigin, site } from 'virtual:shkriuss/site';
import themeInitUrl from '../scripts/theme-init.js?url';
import { backgroundColors } from '../icons/colors.ts';
import AppIcon from '../components/AppIcon.astro';
import Icon from '../components/Icon.astro';
import ThemeSwitch from '../components/ThemeSwitch.astro';

interface Props {
  /** Page title. Leave empty on a site's home page. */
  title?: string | undefined;
  description?: string | undefined;
  /** Use the wider content column (e.g. for grids). */
  wide?: boolean;
  /** Ask search engines not to index this page (e.g. 404). */
  noindex?: boolean;
}

const { title, description = site.description, wide = false, noindex = false } = Astro.props;

const isHub = site.kind === 'hub';
const fullTitle = title ? `${title} · ${site.name}` : site.name;
const canonical = new URL(Astro.url.pathname, site.origin).href;
// On the hub, keep links relative so they also work in previews.
const hubHome = isHub ? '/' : `${hubOrigin}/`;
const privacyHref = isHub ? '/privacy/' : `${hubOrigin}/privacy/`;
const currentPath = Astro.url.pathname;
---

<!doctype html>
<html lang="en" dir="ltr">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    {noindex ? <meta name="robots" content="noindex" /> : <link rel="canonical" href={canonical} />}
    <meta name="color-scheme" content="light dark" />
    <meta
      name="theme-color"
      media="(prefers-color-scheme: light)"
      content={backgroundColors.light}
    />
    <meta name="theme-color" media="(prefers-color-scheme: dark)" content={backgroundColors.dark} />
    <meta name="referrer" content="no-referrer" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/manifest.webmanifest" />
    <meta name="apple-mobile-web-app-title" content={site.name} />
    <script is:inline src={themeInitUrl}></script>
    <slot name="head" />
  </head>
  <body>
    <a class="skip-link" href="#main">
      Skip to content
    </a>
    <div class="shell">
      <header class="site-header">
        <!-- Shown only on previews of a change (scripts/preview-note.ts). -->
        <p class="preview-note" data-preview-note hidden>
          This is a preview of a change to {site.name}, for testing. Don’t use your real shkriuss
          account or your real data here.
        </p>
        <div class="container container--wide site-header__inner">
          <a class="site-brand" href="/" aria-current={currentPath === '/' ? 'page' : undefined}>
            <AppIcon icon={site.icon} color={site.color} size="sm" />
            <span>{site.name}</span>
          </a>
          <nav class="site-nav" aria-label="Main">
            <slot name="nav" />
            {isHub && (
              <a href="/account/" aria-current={currentPath === '/account/' ? 'page' : undefined}>
                <Icon name="user" />
                <span>Account</span>
              </a>
            )}
            {!isHub && (
              <a href={hubHome}>
                <Icon name="grid" />
                <span>All apps</span>
              </a>
            )}
          </nav>
        </div>
      </header>

      <main id="main" class="shell__main" tabindex="-1">
        <div class:list={['container', wide && 'container--wide']}>
          <!--
            Problems, like "Couldn’t save": shown here by scripts/problem.ts,
            above every view of the page, and read out at once.
          -->
          <div class="problem" data-problem></div>
          <slot />
        </div>
      </main>

      <footer class="site-footer">
        <div class="container container--wide cluster cluster--between">
          <nav aria-label="Footer">
            <ul role="list" class="cluster">
              <li>
                <a href={hubHome}>All apps</a>
              </li>
              <li>
                <a
                  href={privacyHref}
                  aria-current={isHub && currentPath === '/privacy/' ? 'page' : undefined}
                >
                  Privacy
                </a>
              </li>
            </ul>
          </nav>
          <ThemeSwitch />
        </div>
      </footer>
    </div>

    <!-- One problem, copied by scripts/problem.ts into [data-problem]. -->
    <template data-problem-template>
      <div class="notice notice--danger problem__notice">
        <p role="alert" data-problem-text></p>
        <button
          type="button"
          class="btn btn--ghost btn--icon problem__hide"
          aria-label="Hide this message"
          data-problem-hide
        >
          <Icon name="x" />
        </button>
      </div>
    </template>

    <script>
      import { returnFocusAfterDialogs } from '../scripts/keep-focus.ts';
      import { showPreviewNote } from '../scripts/preview-note.ts';
      import { registerServiceWorker } from '../scripts/service-worker.ts';

      if (import.meta.env.PROD) registerServiceWorker();
      // A dialog's opener drawn again while it was open gets focus back (audit G-3).
      returnFocusAfterDialogs();
      showPreviewNote();
    </script>
  </body>
</html>
