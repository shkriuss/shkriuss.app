---
/**
 * "Your data" section for apps that store data on the device: back up (a file
 * locked with a passphrase, or a plain copy), restore from a backup, or delete
 * everything. Put it at the bottom of an app's page. The behaviour is in
 * ../scripts/data-controls.ts.
 */
import { site } from 'virtual:shkriuss/site';
import Button from './Button.astro';

interface Props {
  /** Heading level for "Your data" (default 2). */
  level?: 2 | 3;
  /**
   * False for apps whose data is too big for a backup file (like Photos):
   * no "Back up" or "Restore". Put what to do instead in the slot.
   */
  backup?: boolean;
  /**
   * With `backup={false}`: what "Delete all data?" says to do first to keep
   * the data, instead of backing up, which isn't there (audit 4 D-4).
   */
  keepFirst?: string;
}

const { level = 2, backup = true, keepFirst = '' } = Astro.props;
const keep = backup ? 'Back up first if you might want it later.' : keepFirst;
const Heading = `h${level}` as 'h2' | 'h3';
// What the person can turn on that sends data off the device: reminders
// while it's closed don't need sync or an account (audit 3 D-5).
const optIns = [
  ...(site.sync ? ['sync'] : []),
  ...(site.pushNotifications ? ['reminders while it’s closed'] : []),
];
const stays = `Everything ${site.name} saves stays in this browser on this device${
  optIns.length > 0 ? `, unless you turn on ${optIns.join(' or ')}` : '. Nothing is sent anywhere'
}.`;
---

<section
  class="stack"
  aria-labelledby="data-controls-heading"
  data-data-controls
  data-app={site.slug}
>
  <Heading id="data-controls-heading">Your data</Heading>
  <p class="muted">
    {!backup
      ? stays
      : site.sync
        ? `${stays} Back up to keep your own copy.`
        : `${stays} Back up to keep a copy, or to move your data to another device.`}
  </p>
  <p class="muted">
    {`Safari deletes a website's data when it isn't opened for 7 days, unless it's on your Home Screen. Add ${site.name} to your Home Screen${site.sync ? ', or turn on sync' : ''}${backup ? ', and back up now and then' : ''} to keep it safe.`}
  </p>
  <slot />
  <div class="cluster">
    <Button icon="download" data-action="backup" hidden={!backup}>
      Back up
    </Button>
    <Button icon="upload" data-action="restore" hidden={!backup}>
      Restore
    </Button>
    <Button icon="trash" variant="danger" data-action="delete">
      Delete all data
    </Button>
  </div>
  <p class="muted" role="status" data-data-status></p>
  <input
    type="file"
    accept=".json,application/json"
    aria-label="Choose a backup file"
    hidden
    data-restore-file
  />

  <dialog class="dialog" aria-labelledby="backup-title" data-backup-dialog>
    <form class="stack" data-backup-form novalidate>
      <h2 id="backup-title">Back up your data</h2>
      <p>
        A backup is a file with everything {site.name} saves. Lock it with a passphrase so only you
        can open it.
      </p>
      <p class="notice">
        Keep the passphrase somewhere safe, like a password manager. Without it the backup can’t be
        opened, not even by us.
      </p>
      <div class="field">
        <label class="field__label" for="backup-passphrase">
          Passphrase
        </label>
        <p class="field__hint" id="backup-passphrase-hint">
          At least 12 characters. A few random words work well.
        </p>
        <input
          class="input"
          id="backup-passphrase"
          name="passphrase"
          type="password"
          autocomplete="new-password"
          aria-describedby="backup-passphrase-hint backup-passphrase-error"
        />
        <p class="field__error" id="backup-passphrase-error" data-error-for="passphrase"></p>
      </div>
      <div class="field">
        <label class="field__label" for="backup-repeat">
          Type it again
        </label>
        <input
          class="input"
          id="backup-repeat"
          name="repeat"
          type="password"
          autocomplete="new-password"
          aria-describedby="backup-repeat-error"
        />
        <p class="field__error" id="backup-repeat-error" data-error-for="repeat"></p>
      </div>
      <label class="check">
        <input type="checkbox" data-show-passphrase />
        <span>Show passphrase</span>
      </label>
      <p class="muted" role="status" data-dialog-status></p>
      <div class="cluster">
        <Button type="submit" variant="primary" icon="download">
          Download backup
        </Button>
        <Button data-action="cancel">Cancel</Button>
      </div>
      <div class="stack stack--sm">
        <p class="muted">
          Or download a plain copy without a passphrase. Anyone who gets that file can read it.
        </p>
        <p>
          <Button variant="ghost" data-action="backup-plain">
            Download without a passphrase
          </Button>
        </p>
      </div>
    </form>
  </dialog>

  {/* Read out with its title: what the file is, and the warnings shown (data-controls.ts). */}
  <dialog
    class="dialog"
    aria-labelledby="restore-title"
    aria-describedby="restore-summary"
    data-restore-dialog
  >
    <form class="stack" data-restore-form novalidate>
      <h2 id="restore-title">Restore a backup</h2>
      <p id="restore-summary" data-restore-summary></p>
      <div class="field" data-restore-unlock hidden>
        <label class="field__label" for="restore-passphrase">
          Passphrase
        </label>
        <input
          class="input"
          id="restore-passphrase"
          name="passphrase"
          type="password"
          autocomplete="current-password"
          aria-describedby="restore-passphrase-error"
        />
        <p class="field__error" id="restore-passphrase-error" data-error-for="passphrase"></p>
      </div>
      <p class="notice notice--danger" id="restore-warning" data-restore-warning hidden>
        Restoring replaces everything {site.name} has saved on this device now.
      </p>
      <p class="notice notice--danger" id="restore-sync-warning" data-restore-sync-warning hidden>
        Sync is on, so this also replaces {site.name}'s data on your other devices.
      </p>
      <p class="muted" role="status" data-dialog-status></p>
      {/* "Cancel" first, as in the delete dialogs: it has focus when there's no passphrase to type. */}
      <div class="cluster">
        <Button data-action="cancel">Cancel</Button>
        <Button type="submit" variant="primary" data-restore-submit>
          Restore
        </Button>
      </div>
    </form>
  </dialog>

  <dialog class="dialog" aria-labelledby="data-delete-title" data-all-data-dialog>
    <form method="dialog" class="stack">
      <h2 id="data-delete-title">Delete all data?</h2>
      <p>
        This removes everything {site.name} has saved on this device. It can't be undone. {keep}
      </p>
      {site.sync && (
        <p>
          If sync is on, it's turned off on this device first, so your other devices and the online
          copy keep their data.
        </p>
      )}
      <div class="cluster">
        <Button type="submit" value="cancel">
          Cancel
        </Button>
        <Button type="submit" variant="danger" value="confirm">
          Delete everything
        </Button>
      </div>
    </form>
  </dialog>
</section>

<script>
  import { mountDataControls } from '../scripts/data-controls.ts';

  for (const section of document.querySelectorAll<HTMLElement>('[data-data-controls]')) {
    mountDataControls(section);
  }
</script>
