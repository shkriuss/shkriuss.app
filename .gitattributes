# Text files are stored and checked out with LF line endings.
* text=auto eol=lf

# Windows batch files, such as android/gradlew.bat, need CRLF to run.
*.bat text eol=crlf

# Images
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.webp binary
*.avif binary
*.bmp binary
*.ico binary

# Other binary files
*.jar binary
*.apk binary
*.aab binary
*.zip binary
*.pdf binary
